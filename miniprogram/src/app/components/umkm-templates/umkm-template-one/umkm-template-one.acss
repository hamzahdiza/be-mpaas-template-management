.umkm-container {
  background-color: #ffffff;
  min-h-screen: 100vh;
}

.hero-section {
  position: relative;
  height: 35vh;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-overlay {
  position: absolute;
  bottom: 24px;
  left: 24px;
  right: 24px;
  z-index: 10;
}

.category-badge {
  display: inline-block;
  background-color: #f43f5e;
  color: white;
  font-size: 10px;
  font-weight: 900;
  padding: 6px 14px;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 8px;
  box-shadow: 0 10px 20px -5px rgba(244, 63, 94, 0.4);
}

.umkm-name {
  display: block;
  font-size: 32px;
  font-weight: 900;
  color: white;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  font-style: italic;
  line-height: 0.9;
  margin-bottom: 4px;
  text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.location-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.loc-icon {
  width: 10px;
  height: 10px;
}

.loc-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.catalog-section {
  padding: 32px 24px;
}

.section-header {
  margin-bottom: 32px;
}

.section-title {
  display: block;
  font-size: 10px;
  font-weight: 900;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  margin-bottom: 4px;
}

.section-subtitle {
  display: block;
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  font-style: italic;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.product-card {
  display: flex;
  flex-direction: column;
}

.product-img-container {
  position: relative;
  aspect-ratio: 1;
  border-radius: 40px;
  overflow: hidden;
  box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
  border: 1px solid #f8fafc;
  margin-bottom: 16px;
}

.product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.add-btn-float {
  position: absolute;
  bottom: 12px;
  right: 12px;
  width: 40px;
  height: 40px;
  background-color: #f43f5e;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 15px -3px rgba(244, 63, 94, 0.3);
  z-index: 10;
}

.plus-icon {
  width: 20px;
  height: 20px;
}

.product-info {
  padding: 0 8px;
}

.p-name {
  display: block;
  font-size: 14px;
  font-weight: 900;
  color: #1e293b;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 4px;
}

.p-price {
  font-size: 14px;
  font-weight: 900;
  color: #f43f5e;
  letter-spacing: -0.05em;
}

.cart-bar {
  position: fixed;
  bottom: 32px;
  left: 24px;
  right: 24px;
  background-color: #0f172a;
  padding: 16px 24px;
  border-radius: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.4);
  z-index: 100;
  border: 1px solid #1e293b;
}

.cart-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.cart-badge {
  width: 32px;
  height: 32px;
  background-color: #f43f5e;
  color: white;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 14px;
}

.cart-text {
  display: flex;
  flex-direction: column;
}

.cart-total {
  color: white;
  font-size: 16px;
  font-weight: 900;
  letter-spacing: -0.02em;
}

.cart-label {
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
}

.checkout-btn {
  color: #f43f5e;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
