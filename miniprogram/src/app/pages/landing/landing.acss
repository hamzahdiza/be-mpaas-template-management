.content-partners {
  width: calc(100% - 48px);
  display: grid;
  justify-content: space-between;
  align-items: center;
  align-self: center;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 0px 24px;
  flex-wrap: wrap;
}

.content-partners-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  align-content: center;
  /* gap: 12px; */
  align-self: stretch;
  flex-wrap: wrap;
  padding: 0px 24px;
  width: calc(100% - 48px);
}

.transactional-card-banner {
  display: flex;
  position: relative;
  max-width: 100%;
  min-height: 203px;
  flex-direction: column;
  align-items: center;
  border-radius: 8px;
  border: 1px solid #DADADA;
  overflow: hidden;
  background-color: white;
}

.transactional-card-banner-1 {
  display: flex;
  position: relative;
  width: 100%;
  flex-direction: column;
  align-items: center;
  border-radius: 8px;
  border: 1px solid #DADADA;
  overflow: hidden;
  background-color: white;
}

.partner-image-container {
  display: flex;
  width: 100%;
  height: 130px;
  align-items: center;
  border-radius: 8px 8px 0px 0px;
  position: relative;
  overflow: hidden;
}

.partner-image-container-1 {
  display: flex;
  width: 100%;
  height: 130px;
  justify-content: flex-end;
  align-items: center;
  align-self: stretch;
  border-radius: 8px 8px 0px 0px;
  position: relative;
}

.partner-image {
  width: 100%;
  height: 100%;
  border-radius: 8px 8px 0px 0px;
  background-size: cover;
  background-position: center;
}

.partner-image-1 {
  width: 100%;
  height: 100%;
  border-radius: 8px 8px 0px 0px;
  background-size: cover;
  background-position: center;
}

.partner-image-skeleton {
  width: 100%;
  height: 100%;
  border-radius: 8px 8px 0px 0px;
  background-color: #f0f0f0;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
}

.partner-image-1-skeleton {
  width: 100%;
  height: 100%;
  border-radius: 8px 8px 0px 0px;
  background-color: #f0f0f0;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
}

.partner-content-container {
  display: flex;
  width: calc(100% - 24px);
  padding: var(--Spacing-Spacing-3---12px, 12px);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  border-radius: 0px 0px 8px 8px;
}

.partner-tag-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
}

.partner-title-subtitle {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
}

.partner-title-teks {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  align-self: stretch;
  overflow: hidden;
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;
  text-overflow: ellipsis;


  /* Mobile/Headline/Headline 5 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 16.8px */
  margin-bottom: 8px;

}

.partner-subtitle-teks {
  width: 100%;

  color: var(--functional-bw-tones-granite-gray, #7A7A7A);
  font-feature-settings: 'liga'off, 'clig'off;
  text-overflow: ellipsis;
  white-space: normal;

  /* Mobile/Label/Label 3 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 10px;
  font-style: normal;
  font-weight: 400;
  line-height: 120%;
  /* 12px */

  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  max-height: 25px;
}

.partner-price-ratings {
