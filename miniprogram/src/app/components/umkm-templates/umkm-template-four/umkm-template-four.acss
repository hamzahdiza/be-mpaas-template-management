.umkm-v4-container { padding: 16px; background: #F0F2F5; min-height: 100vh; }
.v4-header { margin-bottom: 20px; }
.v4-shop-name { font-size: 24px; font-weight: bold; }
.v4-search { background: white; padding: 10px; border-radius: 8px; margin-top: 10px; color: #999; }
.v4-grid { display: flex; flex-wrap: wrap; gap: 12px; }
.v4-card { width: calc(50% - 6px); background: white; border-radius: 12px; overflow: hidden; }
.v4-card image { width: 100%; height: 150px; }
.v4-info { padding: 10px; }
.v4-pname { font-size: 14px; font-weight: 600; display: block; height: 40px; }
.v4-pprice { color: #007AFF; font-weight: bold; display: block; margin: 8px 0; }
.v4-add { background: #007AFF; color: white; text-align: center; padding: 6px; border-radius: 6px; font-size: 12px; }
.v4-cart { position: fixed; bottom: 20px; left: 16px; right: 16px; background: #007AFF; color: white; padding: 16px; border-radius: 12px; display: flex; justify-content: space-between; transform: translateY(100px); transition: 0.3s; }
.v4-cart.active { transform: translateY(0); }
