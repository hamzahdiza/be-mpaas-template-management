<view class="rental-v2-container">
  <view class="header-v2">
    <view class="title-group">
      <text class="brand-name">{{data.name}}</text>
      <text class="tagline">Explore the city with ease</text>
    </view>
    <image class="mini-logo" src="{{data.bannerUrl}}" mode="aspectFill" />
  </view>

  <view class="promo-banner">
    <image class="promo-bg" src="{{data.bannerUrl}}" mode="aspectFill" />
    <view class="promo-content">
      <text class="promo-text">WEEKEND PROMO</text>
      <text class="promo-disc">20% OFF</text>
    </view>
  </view>

  <view class="grid-section">
    <view class="filter-row">
      <text class="active">All</text>
      <text>Cars</text>
      <text>Bikes</text>
    </view>

    <view class="vehicle-grid">
      <block a:for="{{data.vehicles}}">
        <view class="grid-card" onTap="onVehicleTap" data-item="{{item}}">
          <view class="img-wrapper">
            <image src="{{item.imageUrl}}" mode="aspectFill" />
          </view>
          <view class="card-info">
            <text class="name">{{item.name}}</text>
            <view class="price-row">
              <text class="price">Rp {{item.pricePerDay.toLocaleString('id-ID')}}</text>
              <text class="day">/d</text>
            </view>
            <view class="badges">
              <text class="badge">{{item.transmission === 'automatic' ? 'AT' : 'MT'}}</text>
              <text class="badge">{{item.capacity}}P</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
