.page-container {
  padding: 16px 24px 199px 24px;
  width: calc(auto - 48px);
  /* height: calc(auto - 32px); */
}

.detail-ticket-card {
  width: calc(100% - 32px);
  height: calc(auto - 32px);
  padding: 16px;
  display: flex;
  border-radius: var(--Rounded-Corner-Small---8px, 8px);
  border: 1px solid var(--functional-bw-tones-pale-gray, #DADADA);
  background: var(--Color-Functional-BW-Tones-White, #FFF);
  align-items: center;
  position: relative;
  overflow: hidden;

}

.detail-ticket-image {
  width: 56px;
  height: 56px;
  border-radius: 8px;
}

.detail-ticket-image-container {
  width: 56px;
  height: 100%;
  z-index: 40;
}

.circle-accessories {
  position: absolute;
  width: 110px;
  height: 150px;
  z-index: 10;
  left: -20px;
}

.visitor-title-card {

  padding: 12px 16px;
  width: calc(100% - 32px);
  height: calc(auto - 24px);
  background-color: #F9F9F9;
}

.visitor-data-container {
  border-radius: 8px;
  border: 1px solid var(--functional-bw-tones-pale-gray, #DADADA);
  background: var(--Color-Functional-BW-Tones-White, #FFF);
  padding-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.visitor-data-content {
  padding: 12px 16px;
  width: calc(100% - 32px);
  height: calc(auto - 24px);
}

.line-divider {
  align-self: center;
  width: 279px;
  height: 1px;
  background: #DADADA;
  margin-top: 12px;
  margin-bottom: 12px;
}

.sof-content {
  padding: 12px;
  width: calc(100% - 24px);
  height: calc(auto - 24px);
  border-radius: 8px;
  border: 1px solid var(--functional-bw-tones-pale-gray, #DADADA);
  background: var(--Color-Functional-BW-Tones-White, #FFF);
}

.cta-container {
  background-color: white;
  position: fixed;
  bottom: 0;
  width: calc(100% - 48px);
  padding: 16px 24px 32px 24px;
  box-shadow: 0px -3px 10px 0px rgba(78, 78, 78, 0.15);
}

.not-full .ant-popup-transform-bottom {
  display: flex;
  bottom: 48px;
  right: 24px;
  left: 24px;
  padding: 24px 16px;
  border-radius: 16px;
  background: var(--functional-bw-tones-white, #fff);
  box-shadow: 0 10px 32px 0 rgba(78, 78, 78, 0.27);
}

.not-full-select-account .ant-popup-transform-bottom {
  display: flex;
  bottom: 48px;
  right: 24px;
  left: 24px;
  padding: 16px 16px 24px 16px;
  border-radius: 16px;
  background: var(--functional-bw-tones-white, #fff);
  box-shadow: 0 10px 32px 0 rgba(78, 78, 78, 0.27);
}

.not-full .ant-popup-content {
  display: grid;
  flex-direction: column;
}

.not-full-select-account .ant-popup-content {
  display: grid;
  flex-direction: column;
}
.border-black-button{
  border-radius: var(--Rounded-Corner-XLarge---32px, 32px);
border: 1px solid var(--functional-bw-tones-granite-gray, #7A7A7A);
}