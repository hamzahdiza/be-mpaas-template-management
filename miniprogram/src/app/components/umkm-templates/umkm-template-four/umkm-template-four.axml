<view class="umkm-v4-container">
  <view class="v4-header">
    <text class="v4-shop-name">{{data.name}}</text>
    <view class="v4-search">Search in shop</view>
  </view>
  <view class="v4-grid">
    <block a:for="{{data.products}}">
      <view class="v4-card" onTap="onProductTap" data-item="{{item}}">
        <image src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="v4-info">
          <text class="v4-pname">{{item.name}}</text>
          <text class="v4-pprice">Rp {{item.price.toLocaleString('id-ID')}}</text>
          <view class="v4-add" catchTap="onAddToCart" data-item="{{item}}">BUY</view>
        </view>
      </view>
    </block>
  </view>
  <view class="v4-cart {{cartCount > 0 ? 'active' : ''}}" onTap="onCheckoutClick">
    <text>Cart ({{cartCount}})</text>
    <text>Rp {{totalCartPrice.toLocaleString('id-ID')}}</text>
  </view>
</view>
