.umkm-v3-container {
  background: white;
  min-height: 100vh;
}

.v3-hero {
  height: 300px;
  position: relative;
}

.v3-hero-img {
  width: 100%;
  height: 100%;
}

.v3-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.3);
}

.v3-hero-content {
  position: absolute;
  bottom: 40px;
  left: 30px;
  color: white;
}

.v3-name {
  font-size: 32px;
  font-weight: 300;
  display: block;
  letter-spacing: 4px;
}

.v3-loc {
  font-size: 12px;
  letter-spacing: 2px;
  margin-top: 8px;
  display: block;
}

.v3-content {
  padding: 30px;
}

.v3-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
}

.v3-card {
  width: calc(50% - 15px);
}

.v3-pimg {
  width: 100%;
  height: 200px;
  background: #F9FAFB;
}

.v3-pinfo {
  margin-top: 16px;
  text-align: center;
}

.v3-pname {
  font-size: 14px;
  color: #333;
  display: block;
  letter-spacing: 1px;
}

.v3-pprice {
  font-size: 12px;
  color: #888;
  margin-top: 4px;
  display: block;
}

.v3-cart {
  position: fixed;
  bottom: 40px;
  left: 30px;
  right: 30px;
  background: #333;
  color: white;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  letter-spacing: 2px;
  transform: translateY(100px);
  transition: 0.4s;
}

.v3-cart.show {
  transform: translateY(0);
}
