  padding-top: 40px;
  padding-bottom: 35px;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  position: relative;
  margin-top: auto;
  z-index: 4;
  background-color: white;
}

.tnc-main-text {
  width: 310px;
  color: var(--functional-bw-tones-gray, #A0A0A0);
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Label/Label 3 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 10px;
  font-style: normal;
  font-weight: 400;
  line-height: 170%;
  /* 12px */
}

.tnc-hightlight-text {
  color: var(--Brand-BNI-Orange-Orange-300---Primary, #FF8736);
  text-decoration: underline;
}

/* END LIFESTYLE */

.skeleton {
  position: relative;
  background-color: #eee;
  overflow: hidden;
  width: 100% !important;
  /* border-radius: var(--rounded-corner-small-8-px, 8px); */
}

