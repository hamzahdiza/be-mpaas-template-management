.hotel-index-container {
  background-color: #f8f9fb;
  min-height: 100vh;
}

.tab-row {
  display: flex;
  margin: 12px 16px 0;
  border: 1px solid #ececec;
  border-radius: 999px;
  overflow: hidden;
  background-color: #fff;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 13px;
  color: #7a7a7a;
  font-weight: 500;
}

.tab-item-active {
  background-color: #0ea271;
  color: #fff;
}

.list-wrapper {
  padding: 16px;
}

.hotel-card-t2 {
  position: relative;
  height: 210px;
  border-radius: 16px;
  margin-bottom: 16px;
  overflow: hidden;
}

.banner-t2 {
  width: 100%;
  height: 100%;
}

.overlay-t2 {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.78), transparent);
}

.name-t2 {
  color: #fff;
  font-size: 17px;
  font-weight: 700;
}

.price-t2 {
  margin-top: 4px;
  color: #fff;
  font-size: 12px;
}

.badge-luxury {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #ffffff;
  color: #0e0e0e;
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: bold;
  z-index: 2;
}
