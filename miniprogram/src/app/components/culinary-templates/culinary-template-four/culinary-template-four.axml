<view class="container-index elegant">
  <view class="elegant-header">
    <view class="accent-line-vertical" />
    <text class="elegant-tagline">Experience Excellence</text>
    <text class="merchant-name-elegant">{{data.name}}</text>
    <view class="elegant-location-row">
      <view class="divider-line" />
      <text class="location-text-elegant">{{data.location}}</text>
      <view class="divider-line" />
    </view>
  </view>

  <view class="elegant-list">
    <block a:for="{{data.menuItems}}" a:for-index="idx">
      <view class="elegant-item-card {{idx % 2 === 1 ? 'reverse' : ''}}" onTap="handleRoomTap" data-item="{{item}}">
        <view class="elegant-img-container">
          <image class="elegant-img" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="elegant-img-border" />
        </view>
        <view class="elegant-info">
          <text class="elegant-item-name">{{item.name}}</text>
          <text class="elegant-item-tag">CURATED SELECTION</text>
          <view class="elegant-accent-line" />
          <text class="elegant-item-desc">{{item.description}}</text>
          <view class="elegant-footer-row">
            <text class="elegant-item-price">Rp {{item.price.toLocaleString('id-ID')}}</text>
            <view class="elegant-add-btn" catchTap="onAddClick" data-item="{{item}}">ORDER NOW</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- Cart Bar for T4 (Elegant) -->
  <view class="cart-bar-elegant" onTap="onCheckoutClick" a:if="{{cartCount > 0}}">
    <view class="cart-left-elegant">
      <text class="cart-title-elegant">SELECTED ITEMS ({{cartCount}})</text>
      <text class="cart-merchant-elegant">{{data.name}}</text>
    </view>
    <view class="cart-right-elegant">
      <text class="cart-total-elegant">Rp {{totalCartPrice.toLocaleString('id-ID')}}</text>
      <text class="checkout-label-elegant">PROCEED TO CHECKOUT</text>
    </view>
  </view>
</view>

  <view class="elegant-footer">
    <text class="footer-note-elegant">Table Reservation Required</text>
    <view class="book-btn-elegant">Book an Experience</view>
  </view>
</view>
