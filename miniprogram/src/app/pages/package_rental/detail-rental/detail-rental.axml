<view class="detail-container">
  <view class="sticky-top">
    <top-bar
      type="navigation"
      navigate
      exit
      safeArea
      pixel
      backgroundColor="transparent"
      title=""
      iconL="/src/assets/icons/ic_common_arrow_back_white.svg"
      onTapL="onBack"
    />
  </view>

  <view class="hero-image">
    <image src="{{vehicleData.imageUrl}}" mode="aspectFill" />
    <view class="hero-gradient" />
  </view>

  <view class="content-card">
    <view class="header-info">
      <view>
        <text class="v-type">{{vehicleData.type}}</text>
        <text class="v-name">{{vehicleData.name}}</text>
      </view>
      <view class="price-box">
        <text class="price">Rp {{vehicleData.pricePerDay.toLocaleString('id-ID')}}</text>
        <text class="unit">/ day</text>
      </view>
    </view>

    <view class="spec-grid">
      <view class="spec-item">
        <image src="https://img.icons8.com/ios/50/666666/gearbox.png" />
        <text class="spec-val">{{vehicleData.transmission}}</text>
        <text class="spec-lab">Transmission</text>
      </view>
      <view class="spec-item">
        <image src="https://img.icons8.com/ios/50/666666/groups.png" />
        <text class="spec-val">{{vehicleData.capacity}} Seats</text>
        <text class="spec-lab">Capacity</text>
      </view>
      <view class="spec-item">
        <image src="https://img.icons8.com/ios/50/666666/gas-station.png" />
        <text class="spec-val">Petrol</text>
        <text class="spec-lab">Fuel Type</text>
      </view>
    </view>

    <view class="description-section">
      <text class="section-title">Description</text>
      <text class="desc-text">Experience the ultimate comfort and performance with our {{vehicleData.name}}. Perfect for city trips or long journeys. Well-maintained and fully insured for your peace of mind.</text>
    </view>

    <view class="terms-section">
      <text class="section-title">Rental Terms</text>
      <view class="term-item">- Free cancellation up to 24h</view>
      <view class="term-item">- Full to full fuel policy</view>
      <view class="term-item">- Valid driving license required</view>
    </view>
  </view>

  <view class="bottom-action">
    <button class="btn-rent" onTap="onRentNow">RENT NOW</button>
  </view>
</view>
