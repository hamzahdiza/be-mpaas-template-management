.container-index.hotel-vintage {
  background-color: #faf7f2;
  min-height: 100vh;
  font-family: 'Times New Roman', Times, serif;
}

.vintage-header {
  padding: 96px 48px 96px;
  text-align: center;
  position: relative;
}

.vintage-accent-line-top {
  position: absolute;
  top: 48px;
  left: 50%;
  width: 48px;
  height: 1px;
  background-color: #8c7b6e;
  transform: translateX(-50%);
}

.vintage-tagline {
  font-size: 10px;
  font-weight: 900;
  color: #8c7b6e;
  text-transform: uppercase;
  letter-spacing: 0.6em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 32px;
  display: block;
}

.vintage-hotel-name {
  font-size: 48px;
  color: #4a3e37;
  line-height: 0.85;
  margin-bottom: 48px;
  display: block;
  font-style: italic;
  letter-spacing: -0.025em;
}

.vintage-stars {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-bottom: 40px;
}

.vintage-star {
  color: #8c7b6e;
  font-size: 12px;
}

.vintage-hotel-desc {
  font-size: 14px;
  font-style: italic;
  color: #6b5e55;
  line-height: 1.6;
  padding: 0 24px;
  max-width: 320px;
  margin: 0 auto;
  opacity: 0.8;
  display: block;
}

.vintage-list {
  padding: 0 40px;
}

.vintage-room-card {
  margin-bottom: 128px;
  text-align: center;
}

.vintage-img-wrapper {
  position: relative;
  aspect-ratio: 4/5;
  border-top-left-radius: 999px;
  border-top-right-radius: 999px;
  overflow: hidden;
  border: 12px solid white;
  box-shadow: 0 48px 80px -12px rgba(74, 62, 55, 0.2);
  margin-bottom: 40px;
}

.vintage-room-img {
  width: 100%;
  height: 100%;
}

.vintage-img-overlay {
  position: absolute;
  inset: 0;
  background-color: rgba(74, 62, 55, 0.1);
}

.vintage-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.vintage-room-name {
  font-size: 32px;
  color: #4a3e37;
  margin-bottom: 16px;
  font-style: italic;
  line-height: 1;
}

.vintage-accent-divider {
  width: 48px;
  height: 1px;
  background-color: rgba(140, 123, 110, 0.3);
  margin-bottom: 16px;
}

.vintage-price-tag {
  font-size: 10px;
  font-weight: 900;
  color: #8c7b6e;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-family: -apple-system, sans-serif;
}

.vintage-footer {
  margin-top: 160px;
  padding: 80px 48px 96px;
  text-align: center;
  border-top: 1px solid rgba(140, 123, 110, 0.1);
}

.vintage-footer-tag {
  font-size: 10px;
  font-weight: 900;
  color: #8c7b6e;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 24px;
  display: block;
}

.vintage-inquire-btn {
  padding: 24px 48px;
  background-color: #4a3e37;
  color: #faf7f2;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}
