.sticky-top {
  position: sticky;
  top: 0;
  z-index: 100;
}
.scroll-container {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  position: relative;
  background-color: #F7F6FB;
  min-height: 100vh;
}

/* ─── SERVICES GRID ─── */
.services-section {
  width: 100%;
  background-color: #ffffff;
  padding: 20px 0;
  z-index: 4;
  position: relative;
  flex: 1;
}
.services-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 0 16px;
}

/* BASE SERVICE CARD */
.service-card {
  border-radius: 16px;
  overflow: hidden;
  background-color: #ffffff;
  border: 0.5px solid rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease;
}
.service-card:active {
  transform: scale(0.98);
}
.service-card-img {
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background-color: #F5F5F5;
}
.service-card-cover {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  position: absolute;
  top: 0;
  left: 0;
}
.service-card-img-skeleton {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
}
.service-card-body {
  padding: 12px;
  display: flex;
  flex-direction: column;
}
.service-card-tag {
  display: inline-flex;
  align-items: center;
  font-family: "TT Interphases Pro";
  font-size: 10px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 6px;
  margin-bottom: 8px;
  align-self: flex-start;
  text-transform: uppercase;
}
.service-card-title {
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}
.service-card-sub {
  font-family: "TT Interphases Pro";
  font-size: 11px;
  font-weight: 400;
  color: #666666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* COLOR THEMES */
.theme-purple .service-card-img { background: linear-gradient(135deg, #EDE8FB 0%, #CFC4F0 100%); }
.service-tag-purple { background-color: #EDE8FB; color: #7C5CBF; }

/* SKELETON */
.skeleton {
  position: relative;
  background-color: #eee;
  overflow: hidden;
  width: 100% !important;
}
.skeleton::after {
  content: "";
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: skeleton-loading 1.5s infinite;
}
@keyframes skeleton-loading {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

