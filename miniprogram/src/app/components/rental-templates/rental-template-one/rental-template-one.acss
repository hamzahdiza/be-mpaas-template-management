.rental-container {
  background-color: #f8fafc;
  min-h-screen: 100vh;
}

.hero-section {
  position: relative;
  height: 45vh;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-overlay {
  position: absolute;
  bottom: 40px;
  left: 24px;
  right: 24px;
  z-index: 10;
}

.category-badge {
  display: inline-block;
  background-color: #4f46e5;
  color: white;
  font-size: 10px;
  font-weight: 900;
  padding: 6px 14px;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 12px;
  box-shadow: 0 10px 20px -5px rgba(79, 70, 229, 0.4);
}

.rental-name {
  display: block;
  font-size: 36px;
  font-weight: 900;
  color: white;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  font-style: italic;
  line-height: 0.9;
  margin-bottom: 8px;
  text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
}

.location-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.loc-icon {
  width: 12px;
  height: 12px;
}

.loc-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.fleet-section {
  padding: 32px 24px;
}

.section-header {
  margin-bottom: 32px;
}

.section-title {
  display: block;
  font-size: 12px;
  font-weight: 900;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  margin-bottom: 4px;
}

.section-subtitle {
  display: block;
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  text-transform: uppercase;
  letter-spacing: -0.05em;
  font-style: italic;
}

.vehicle-list {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.vehicle-card {
  background-color: white;
  border-radius: 32px;
  overflow: hidden;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.05);
  border: 1px solid #f1f5f9;
}

.vehicle-img-container {
  position: relative;
  height: 200px;
}

.vehicle-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.availability-badge {
  position: absolute;
  top: 16px;
  right: 16px;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 6px 14px;
  border-radius: 12px;
  font-size: 9px;
  font-weight: 900;
  color: #4f46e5;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.vehicle-info {
  padding: 24px;
}

.info-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16px;
}

.v-name {
  font-size: 20px;
  font-weight: 900;
  color: #0f172a;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  font-style: italic;
}

.price-box {
  text-align: right;
}

.v-price {
  display: block;
  font-size: 18px;
  font-weight: 900;
  color: #4f46e5;
  letter-spacing: -0.05em;
}

.v-unit {
  font-size: 10px;
  font-weight: 700;
  color: #cbd5e1;
  text-transform: uppercase;
}

.info-bottom {
  display: flex;
  justify-content: space-between;
  padding-top: 16px;
  border-top: 1px solid #f8fafc;
}

.spec-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spec-label {
  font-size: 8px;
  font-weight: 800;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 2px;
}

.spec-val {
  font-size: 10px;
  font-weight: 900;
  color: #1e293b;
  text-transform: uppercase;
}
