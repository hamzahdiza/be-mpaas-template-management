.middle-container {
  margin: 0 24px;
  padding-bottom: 145px;


}

.image-container {
  display: flex;
  justify-content: center;
}

.illustration {
  width: 165px;
  height: 107px;

}

.title-status-container {
  display: flex;
  justify-content: center;
  margin-top: 24px;
}

.value-container {
  margin-top: 4px;
  display: flex;
  justify-content: center;
  text-align: center;
}

.value-text {
  font-size: 40px;
  font-weight: 800;
}

.time-container {
  margin-top: 4px;
  display: flex;
  justify-content: center;
}

.date-text {
  margin-right: 4px;
}

.timestamp-text {
  margin: 0 4px;
}

.ref-container {
  display: flex;
  justify-content: center;
  padding: 4px 10px;

}

.description-container {
  /* display: flex;
  justify-content: center; */
  text-align: center;
  margin-top: 4px;
  padding: 8px 10px;
}

.middle-button-container {
  display: flex;
  justify-content: center;
  margin: 0 12px;
  margin-top: 24px;

}

.feature-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 12px;
  margin-top: 24px;

}

.feature-image {
  width: 36.7px;
  height: 36.7px;

}

.feature-text {
  width: 73px;
  text-align: center;
  margin-top: 8px;
}

.feature-button {
  background-color: #FF8736;
  border-radius: 16px;

  display: flex;
  justify-content: center;

  width: 66px;
  height: 66px;
  

  padding:12px;}

.disabled-button {
  background-color: #F0F0F0;

}

.account-container {
  margin-top: 16px;

}

.account-container-text {
 padding: 12px;
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  margin-top: 12px;

  border-radius: 8px;
  border: 1px solid #DADADA;

}


.account-name {
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-account {
  margin-top: 24px;
}
.dest-name{
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bottom-container {
  background-color: red;
  position: fixed;
  bottom: 0;
  width: 325px;
  padding: 16px 24px 32px 24px;
  box-shadow: 0px -3px 10px 0px rgba(78, 78, 78, 0.15);
}

.popup-container {
  display: flex;
  flex-direction: column;
  padding:24px 16px;}


.ant-popup-content {
  display: grid;
  flex-direction: column;

}

.ant-popup-transform-bottom {
  display: flex;
  bottom: 24px;
  right: 24px;
  left: 24px;
  border-radius: 16px;
  background: var(--functional-bw-tones-white, #fff);
  box-shadow: 0 10px 32px 0 rgba(78, 78, 78, 0.27);
}

.title-contact-container {
  display: flex;
  align-items: center;
}

.warning-image {
  width: 32px;
  height: 32px;
}

.title-contact-text {
  margin-left: 8px;
}

.contact-desc {
  margin-top: 8px;
}

.indicator-bottom-px{
  min-height: 17px
}