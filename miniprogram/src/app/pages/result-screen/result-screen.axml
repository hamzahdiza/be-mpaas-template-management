<view>

  <top-bar safeArea="true" title=" " pixel backgroundColor="bg-white" />
  <view class="middle-container">
    <view class="image-container">
      <image id="" class="illustration" src={{illustrationSource}} />
    </view>

    <view class="title-status-container">
      <text id="" class="txt-h3-px">
        {{titleStatus}}
      </text>
    </view>
    <view class="value-container">
      <text id="" class="value-text">
        {{nominalAmount}}
      </text>
    </view>
    <view class="time-container">
      <text id="" class="date-text txt-body2-px">
        {{timeStamp}}
      </text>
    </view>

    <view class="ref-container">
      <text id="" class="ref-text txt-body2-px">
        {{lang.lifestyleBillPaymentJavaJazzFestivalResultScreenRefIDLabel}}: {{refId}}
      </text>
    </view>
    <view a:if="{{ descriptionText.length }}" class="description-container">
      <text id="" class="txt-body2-px">
        {{descriptionText}}
      </text>
    </view>
    <view class="middle-button-container">
      <view a:for="{{ buttonFeatures }}" class="feature-container">
        <button
          id={{item.iconId}}
          disabled={{item.disabled}}
          data-name={{item.name}}
          onTap="featureHandler"
          class="feature-button {{item.disabled? 'disabled-button' : ''}}"
        >
          <image class="feature-image" src="{{item.icon}}" />
        </button>
        <text id={{item.textId}} class="feature-text txt-label2-sb-px {{item.disabled? 'txt-granite' : ''}}">
          {{
          item.name}}
        </text>
      </view>

    </view>
    <view class="account-container">
      <text id="" class="account-title  txt-label2-sb-px">
        {{lang.lifestyleBillPaymentJavaJazzFestivalResultScreenProviderTitleLabel}}
      </text>
      <view class="account-container-text">
        <text id="" class=" txt-body2-px account-name">

          {{billerInfo.categoryName}} • {{eventTitle}}
        </text>
        <text id="" class="txt-body2-px dest-name">
          {{transactionData.dataProtected.billKey1}} • {{userAccInfo.accountName}}
        </text>
      </view>
    </view>
    <view class="account-container user-account">
      <text id="" class=" account-title txt-label2-sb-px">
        {{lang.lifestyleBillPaymentJavaJazzFestivalResultScreenSourceAccountTitleLabel}}
      </text>
      <view class="account-container-text">
        <text id="" class="txt-body2-px account-name">
          {{userAccInfo.accountName}}
        </text>
        <text id="" class="txt-body2-px">
          {{userAccInfo.productName}} • {{userAccInfo.accountNumber}}
        </text>
      </view>
    </view>

  </view>
</view>

<ant-popup animation=true visible={{isFailCustomModal}}>
  <view class="popup-container full-modal">

    <view class="title-contact-container">
      <image class="warning-image" src="/src/assets/icons/ic_common_error_filled.svg" />
      <text class="txt-h3-px title-contact-text">
        {{failCustomRes.title}}
      </text>
    </view>
    <text class="txt-body2-px contact-desc">
      {{failCustomRes.description}}
    </text>
  </view>
</ant-popup>

<bni-button
  a:if="{{ !isFailCustomModal}}"
  pixel
  type="sticky"
  shadow="{{true}}"
  titlePrimaryButton={{lang.lifestyleBillPaymentJavaJazzFestivalResultScreenShareBackToHomeButtonLabel}}
  id=""
  onTapPrimaryButton="homeHandler"
  className="txt-label1-sb-px bg-turquoise-300 bottom-sticky"
>
</bni-button>

<ant-popup animation=true visible={{isStillPending}}>
  <view class="popup-container full-modal">

    <view class="title-contact-container">
      <image class="warning-image" src="/src/assets/icons/ic_common_error_filled.svg" />
      <text class="txt-h3-px title-contact-text">
        {{lang.lifestyleBillPaymentResultScreenCheckStatusTitleLabel}}
      </text>
    </view>
    <text class="txt-body2-px contact-desc">
      {{lang.lifestyleBillPaymentResultScreenCheckStatusDescriptionLabel}}
    </text>

    <view class="button-popup-container">
      <bni-button pixel onTap="closeStillPending" type="primary" className="txt-label1-sb-px bg-turquoise-300">
        {{lang.lifestyleBillPaymentResultScreenCheckStatusConfirmButtonLabel}}
      </bni-button>

    </view>
  </view>
</ant-popup>
<loading loading="{{ isFetching }}" pixel></loading>
<error-internet></error-internet>