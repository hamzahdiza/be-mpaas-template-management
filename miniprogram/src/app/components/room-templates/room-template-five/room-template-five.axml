<view class="container-detail-vintage">
  <view class="vintage-detail-body">
    <view class="vintage-detail-header">
      <view class="vintage-back-btn-text" onTap="onBack">
        <text class="vintage-arrow-large">←</text>
        <text class="vintage-btn-label-large">The Archives</text>
      </view>
    </view>
    
    <view class="vintage-hero-room-arch">
      <image class="vintage-room-img-arch" src="{{room.images[0]}}" mode="aspectFill" />
    </view>
    
    <view class="vintage-info-section-arch">
      <text class="vintage-tag-arch">Imperial Collection</text>
      <text class="vintage-room-name-arch">{{room.name}}</text>
      <view class="vintage-accent-divider-arch" />
      <text class="vintage-room-desc-arch">{{room.description}}</text>
      
      <view class="vintage-action-section-arch">
        <view class="vintage-price-col-arch">
          <text class="vintage-price-label-arch">Daily Contribution</text>
          <text class="vintage-price-val-arch">Rp {{room.pricePerNight.toLocaleString('id-ID')}}</text>
        </view>
        <view class="vintage-request-btn-arch" onTap="onBook">
          Formal Request →
        </view>
      </view>
    </view>
  </view>
</view>
