.t5-book-container {
    min-height: 100vh;
    background-color: #F9FAFB;
    padding-bottom: 100px;
}

.t5-sticky-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #F9FAFB;
    border-bottom: 1px solid #E5E7EB;
}

.t5-book-content {
    padding: 20px;
}

.t5-book-info {
    margin-bottom: 24px;
}

.t5-book-title {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 8px;
    display: block;
}

.t5-book-meta {
    display: flex;
    align-items: center;
    gap: 8px;
}

.t5-icon-sm {
    width: 16px;
    height: 16px;
}

.t5-meta-text {
    font-size: 14px;
    color: #6B7280;
}

/* Premium Segmented Tab Style */
.tab-segmented {
  display: flex;
  background-color: #f3f4f6;
  border-radius: 12px;
  padding: 4px;
  margin-top: 24px;
  margin-bottom: 24px;
}

.tab-pill {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  border-radius: 9px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-pill.active {
  background-color: #FFFFFF;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  color: #111111;
  font-weight: 700;
}

.tab-pill.inactive {
  color: #6B7280;
  font-weight: 500;
}

.tab-text {
  font-size: 14px;
}

.t5-ticket-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.t5-ticket-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 16px;
}

.t5-disabled {
    opacity: 0.6;
    background: #F9FAFB;
}

.t5-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
}

.t5-card-title {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    flex: 1;
    margin-right: 8px;
}

.t5-tag {
    background: #F3F4F6;
    color: #4B5563;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #E5E7EB;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.t5-card-date {
    font-size: 12px;
    color: #6B7280;
    display: block;
    margin-bottom: 12px;
}

.t5-card-desc {
    margin-bottom: 16px;
}

.t5-desc-line {
    font-size: 13px;
    color: #4B5563;
}

.t5-price-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 16px;
    border-top: 1px solid #F3F4F6;
}

.t5-price-group {
    display: flex;
    flex-direction: column;
}

.t5-price-final {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
}

.t5-price-original {
    font-size: 12px;
    color: #9CA3AF;
    text-decoration: line-through;
}

.t5-counter {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #F9FAFB;
    padding: 4px;
    border-radius: 8px;
    border: 1px solid #E5E7EB;
}

.t5-btn-minus {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border-radius: 6px;
    border: 1px solid #E5E7EB;
    font-weight: bold;
    color: #9CA3AF;
}

.t5-btn-plus {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111827;
    border-radius: 6px;
    border: 1px solid #111827;
    font-weight: bold;
    color: #FFFFFF;
}

.t5-btn-disabled {
    opacity: 0.5;
    background: #F3F4F6;
}

.t5-qty {
    font-weight: 600;
    min-width: 20px;
    text-align: center;
}

.t5-sold-out {
    background: #F3F4F6;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    color: #6B7280;
    font-weight: 500;
}

.t5-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #FFFFFF;
    border-top: 1px solid #E5E7EB;
    padding: 16px 20px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 90;
}

.t5-total-label {
    font-size: 10px;
    color: #9CA3AF;
    display: block;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
    margin-bottom: 2px;
}

.t5-checkout-btn-wrapper {
    display: flex;
    justify-content: space-between;
}

.t5-checkout-btn {
    width: 200px;
    height: 50px;
    background: #111827;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

.t5-checkout-btn[disabled] {
    background: #E5E7EB;
    color: #9CA3AF;
    box-shadow: none;
}

.t5-total-price {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
}

/* Toast utils */
.toast-position {
  position: absolute;
  top: 16px;
  left: 16px;
  right: 16px;
  z-index: 999;
}

.toast-container-in {
  opacity: 1;
  transition: opacity 0.3s ease-in;
}

.toast-container-out {
  opacity: 0;
  transition: opacity 0.3s ease-out;
}
