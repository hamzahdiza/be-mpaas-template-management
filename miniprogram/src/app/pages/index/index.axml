<view a:if="{{ successFetch }}">
  <view class="top-bar" a:if="{{templateId != 4 && templateId != 5}}">
    <top-bar
      type="navigation"
      navigate
      exit
      safeArea
      pixel
      backgroundColor="var(--white)"
      title="{{detailEvent.eventName}}"
      iconL="/src/assets/icons/ic_common_arrow_back.svg"
    />
  </view>

  <!-- Template Switcher -->
  <template-one 
    a:if="{{templateId == 1 || !templateId}}" 
    detailEvent="{{detailEvent}}" 
    ticketDataList="{{ticketDataList}}" 
    lang="{{lang}}"
    onGoToTicketList="goToTicketList"
    onPopupPromo="popupPromo"
  />

  <template-two 
    a:if="{{templateId == 2}}" 
    detailEvent="{{detailEvent}}" 
    ticketDataList="{{ticketDataList}}" 
    onGoToTicketList="goToTicketList"
  />

  <template-three 
    a:if="{{templateId == 3}}" 
    detailEvent="{{detailEvent}}" 
    ticketDataList="{{ticketDataList}}" 
    onGoToTicketList="goToTicketList"
  />

  <template-four 
    a:if="{{templateId == 4}}" 
    detailEvent="{{detailEvent}}" 
    ticketDataList="{{ticketDataList}}" 
    onGoToTicketList="goToTicketList"
  />

  <template-five 
    a:if="{{templateId == 5}}" 
    detailEvent="{{detailEvent}}" 
    ticketDataList="{{ticketDataList}}" 
    lang="{{lang}}"
    onGoToTicketList="goToTicketList"
  />

</view>

<popup-image visible="{{isFullscreen}}" position="center" height="100vh" maskStyle="background-color: rgba(14, 14, 14, 0.80)">
  <view class="icon-close-fullscreen" onTap="popupPromoClose">
    <image class="icon-size-48" src="/src/assets/icons/ic_common_close_white.svg" />
  </view>
  <view class="image-fullscreen">
    <image class="zoomable-image" src="{{imageFullScreen}}" />
  </view>
</popup-image>

<view a:if="{{ !successFetch && !isLoading }}">
  <view class="top-bar">
    <top-bar
      type="navigation"
      navigate
      exit
      safeArea
      pixel
      backgroundColor="var(--white)"
      title="{{lang.lifestyleJavaJazzFestivalLandingScreenHeaderTitleLabel}}"
      iconL="/src/assets/icons/ic_common_arrow_back.svg"
    />
  </view>
  <error-reload
    reloadId="lifestyle-java-jazz-festival-landing-page-screen-refresh"
    onReload="getPendingOrder"
    title="{{lang.lifestyleJavaJazzFestivalLandingScreenMuatUlangTitleLabel}}"
    desc="{{lang.lifestyleJavaJazzFestivalLandingScreenMuatUlangDescLabel}}"
  >
  </error-reload>
</view>

<loading pixel  loading="{{ isLoading }}"></loading>

<!-- The interface returns a 503 popup -->
<feature-modal></feature-modal>
<!-- error internet -->
<error-internet></error-internet>
<!-- general-error -->
<general-error></general-error>


