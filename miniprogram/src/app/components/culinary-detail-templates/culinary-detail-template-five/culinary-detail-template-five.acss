.container-detail-modern {
  background-color: white;
  min-height: 100vh;
  padding: 24px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.detail-header-modern {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48px;
  padding-top: 16px;
}

.back-btn-modern, .heart-btn-modern {
  width: 48px;
  height: 48px;
  background-color: #f8fafc;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.essence-label-modern {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-style: italic;
}

.item-hero-modern {
  background-color: #f8fafc;
  border-radius: 64px;
  padding: 40px;
  margin-bottom: 48px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.hero-bg-accent {
  position: absolute;
  inset: 0;
  background-color: rgba(16, 185, 129, 0.05);
}

.hero-img-modern {
  width: 256px;
  height: 256px;
  border-radius: 50%;
  margin: 0 auto 40px;
  border: 8px solid white;
  box-shadow: 0 32px 64px -12px rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 10;
}

.item-name-modern-detail {
  font-size: 32px;
  font-weight: 900;
  letter-spacing: -0.05em;
  color: #0f172a;
  text-transform: uppercase;
  font-style: italic;
  line-height: 1;
  margin-bottom: 8px;
  display: block;
  position: relative;
  z-index: 10;
}

.item-price-modern-detail {
  font-size: 24px;
  font-weight: 900;
  color: #059669;
  letter-spacing: -0.05em;
  position: relative;
  z-index: 10;
}

.modern-info-grid {
  display: flex;
  gap: 40px;
  padding: 0 16px;
  margin-bottom: 40px;
}

.info-stat-modern {
  display: flex;
  flex-direction: column;
}

.stat-label-modern {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 8px;
}

.stat-val-modern {
  font-size: 14px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.025em;
}

.story-section-modern {
  padding: 0 16px;
  margin-bottom: 40px;
}

.story-label-modern {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 12px;
  display: block;
}

.story-text-modern {
  font-size: 16px;
  font-weight: 700;
  color: #64748b;
  line-height: 1.6;
  font-style: italic;
}

.footer-action-modern {
  padding: 32px 16px;
}

.add-basket-btn-modern {
  background-color: #0f172a;
  color: white;
  padding: 24px;
  border-radius: 40px;
  text-align: center;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}
