<view class="rental-v5-container">
  <view class="v5-hero">
    <image src="{{data.bannerUrl}}" mode="aspectFill" class="v5-bg" />
    <view class="v5-hero-content">
      <text class="v5-badge">READY TO GO</text>
      <text class="v5-title">{{data.name}}</text>
    </view>
  </view>

  <view class="v5-body">
    <view class="v5-stats">
      <view class="v5-stat">
        <text class="v5-val">{{data.vehicles.length}}</text>
        <text class="v5-lab">Units</text>
      </view>
      <view class="v5-stat">
        <text class="v5-val">4.8</text>
        <text class="v5-lab">Rating</text>
      </view>
      <view class="v5-stat">
        <text class="v5-val">24/7</text>
        <text class="v5-lab">Support</text>
      </view>
    </view>

    <view class="v5-list">
      <block a:for="{{data.vehicles}}">
        <view class="v5-card" onTap="onVehicleTap" data-item="{{item}}">
          <image class="v5-vimg" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="v5-vinfo">
            <text class="v5-vname">{{item.name}}</text>
            <view class="v5-vbottom">
              <text class="v5-vprice">Rp {{item.pricePerDay.toLocaleString('id-ID')}}</text>
              <view class="v5-go">ΓåÆ</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
