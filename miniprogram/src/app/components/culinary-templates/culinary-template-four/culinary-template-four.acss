.container-index.elegant {
  background-color: #faf9f6;
  min-height: 100vh;
  font-family: 'Times New Roman', Times, serif;
}

.elegant-header {
  padding: 96px 48px 80px;
  text-align: center;
  position: relative;
}

.accent-line-vertical {
  position: absolute;
  top: 48px;
  left: 50%;
  width: 1px;
  height: 48px;
  background-color: #e2e8f0;
  transform: translateX(-50%);
}

.elegant-tagline {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 24px;
  display: block;
}

.merchant-name-elegant {
  font-size: 40px;
  font-style: italic;
  color: #0f172a;
  letter-spacing: -0.025em;
  margin-bottom: 24px;
  display: block;
  line-height: 1;
}

.elegant-location-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
}

.divider-line {
  width: 32px;
  height: 1px;
  background-color: #cbd5e1;
}

.location-text-elegant {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-family: -apple-system, sans-serif;
}

.elegant-list {
  padding: 0 40px;
}

.elegant-item-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 128px;
}

.elegant-item-card.reverse {
  align-items: flex-end;
  text-align: right;
}

.elegant-img-container {
  position: relative;
  width: 100%;
  aspect-ratio: 4/5;
  margin-bottom: 48px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}

.elegant-img {
  width: 100%;
  height: 100%;
}

.elegant-img-border {
  position: absolute;
  inset: 0;
  border: 20px solid rgba(250, 249, 246, 0.05);
}

.elegant-info {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 85%;
}

.elegant-item-name {
  font-size: 28px;
  font-style: italic;
  color: #0f172a;
  line-height: 1;
}

.elegant-item-tag {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-family: -apple-system, sans-serif;
}

.elegant-accent-line {
  width: 48px;
  height: 1px;
  background-color: #0f172a;
}

.elegant-item-card.reverse .elegant-accent-line {
  margin-left: auto;
}

.elegant-item-desc {
  font-size: 14px;
  color: #64748b;
  font-style: italic;
  line-height: 1.6;
  font-family: -apple-system, sans-serif;
}

.elegant-item-price {
  font-size: 16px;
  font-weight: 700;
  color: #c2410c;
  margin-top: auto;
}

.elegant-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
}

.elegant-add-btn {
  font-size: 10px;
  font-weight: 800;
  color: #c2410c;
  letter-spacing: 0.1em;
  padding: 4px 0;
  border-bottom: 1px solid #c2410c;
}

.cart-bar-elegant {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #f1f5f9;
  box-shadow: 0 -10px 25px -5px rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.cart-left-elegant {
  display: flex;
  flex-direction: column;
}

.cart-title-elegant {
  font-size: 10px;
  font-weight: 800;
  color: #64748b;
  letter-spacing: 0.1em;
  margin-bottom: 4px;
}

.cart-merchant-elegant {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
}

.cart-right-elegant {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.cart-total-elegant {
  font-size: 18px;
  font-weight: 700;
  color: #c2410c;
  margin-bottom: 2px;
}

.checkout-label-elegant {
  font-size: 10px;
  font-weight: 800;
  color: #c2410c;
  letter-spacing: 0.05em;
}

.elegant-footer {
  margin-top: 160px;
  padding: 0 48px 96px;
  text-align: center;
  border-top: 1px solid #f1f5f9;
  padding-top: 80px;
}

.footer-note-elegant {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 32px;
  display: block;
}

.book-btn-elegant {
  padding: 20px 48px;
  border: 1px solid #0f172a;
  font-size: 10px;
  font-weight: 900;
  color: #0f172a;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
}
