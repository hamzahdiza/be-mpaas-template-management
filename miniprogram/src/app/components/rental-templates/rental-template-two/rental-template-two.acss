.rental-v2-container {
  padding: 16px;
  background: #F8F9FA;
  min-height: 100vh;
}

.header-v2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.brand-name {
  font-size: 24px;
  font-weight: 800;
  color: #1A1A1A;
  display: block;
}

.tagline {
  font-size: 12px;
  color: #6C757D;
}

.mini-logo {
  width: 48px;
  height: 48px;
  border-radius: 12px;
}

.promo-banner {
  position: relative;
  height: 120px;
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 24px;
}

.promo-bg {
  width: 100%;
  height: 100%;
  filter: brightness(0.7);
}

.promo-content {
  position: absolute;
  top: 50%;
  left: 20px;
  transform: translateY(-50%);
}

.promo-text {
  color: white;
  font-size: 14px;
  font-weight: 600;
  display: block;
}

.promo-disc {
  color: #FFD700;
  font-size: 28px;
  font-weight: 900;
}

.filter-row {
  display: flex;
  gap: 20px;
  margin-bottom: 16px;
}

.filter-row text {
  font-size: 14px;
  color: #ADB5BD;
  font-weight: 600;
}

.filter-row .active {
  color: #007BFF;
  border-bottom: 2px solid #007BFF;
}

.vehicle-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.grid-card {
  width: calc(50% - 6px);
  background: white;
  border-radius: 16px;
  padding: 8px;
  box-sizing: border-box;
}

.img-wrapper {
  width: 100%;
  height: 100px;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 8px;
}

.img-wrapper image {
  width: 100%;
  height: 100%;
}

.card-info .name {
  font-size: 14px;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 4px;
}

.price-row {
  margin-bottom: 8px;
}

.price {
  font-size: 13px;
  font-weight: 800;
  color: #007BFF;
}

.day {
  font-size: 10px;
  color: #6C757D;
}

.badges {
  display: flex;
  gap: 4px;
}

.badge {
  font-size: 9px;
  background: #F1F3F5;
  color: #495057;
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 600;
}
