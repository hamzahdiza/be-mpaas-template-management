<view class="container-detail-elegant">
  <view class="elegant-detail-inner">
    <view class="back-btn-text-elegant" onTap="onBack">
      <text class="arrow-elegant">←</text>
      <text class="btn-label-elegant">Return to Menu</text>
    </view>
    
    <view class="item-hero-elegant">
      <image class="hero-img-elegant" src="{{room.imageUrl}}" mode="aspectFill" />
      <view class="hero-overlay-elegant" />
    </view>
    
    <view class="elegant-detail-info">
      <view class="info-header-elegant">
         <text class="info-tag-elegant">Signature Dish</text>
         <text class="item-name-elegant-detail">{{room.name}}</text>
         <view class="accent-divider-elegant" />
      </view>
      
      <text class="item-desc-elegant">{{room.description}}</text>
      
      <view class="elegant-action-section">
        <view class="price-container-elegant">
          <text class="price-label-elegant">Investment</text>
          <text class="price-val-elegant">Rp {{room.price.toLocaleString('id-ID')}}</text>
        </view>
        <view class="place-order-btn-elegant" onTap="onBook">
          Place Order
        </view>
      </view>
    </view>
  </view>
</view>
