<view class="room-detail-wrapper animate-slide-right">
  <view class="header-gallery">
    <view class="back-button-floating" onTap="onBackTap">
      <image src="/src/assets/icons/ic_common_arrow_back_white.svg" class="icon-back" />
    </view>
    
    <swiper indicator-dots="{{true}}" autoplay="{{true}}" class="room-swiper">
      <block a:for="{{room.images}}">
        <swiper-item>
          <image src="{{item}}" mode="scaleToFill" class="image-slider" />
        </swiper-item>
      </block>
    </swiper>
    <view class="top-gradient" />
  </view>

  <scroll-view scroll-y="{{true}}" class="content-scroll">
    <view class="body-container">
      <view class="handle-bar" />

      <view class="header-info">
        <view class="badge-type">
          <text class="badge-text">{{room.roomType}}</text>
        </view>
        <text class="room-title">{{room.name}}</text>
      </view>

      <view class="specs-grid">
        <view class="spec-card">
          <text class="spec-label">BED</text>
          <text class="spec-value">{{room.bedConfig.count}} {{room.bedConfig.type}}</text>
        </view>
        <view class="spec-card">
          <text class="spec-label">MAX GUESTS</text>
          <text class="spec-value">{{room.capacity}} Persons</text>
        </view>
      </view>

      <view class="section-group">
        <text class="section-label">DESCRIPTION</text>
        <text class="section-content">{{room.description}}</text>
      </view>

      <view class="section-group" a:if="{{room.roomAmenities.length > 0}}">
        <text class="section-label">ROOM FEATURES</text>
        <view class="tag-grid">
          <block a:for="{{room.roomAmenities}}">
            <view class="tag-blue">
              <text class="tag-text">✓ {{item}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="section-group" a:if="{{room.bathAmenities.length > 0}}">
        <text class="section-label">BATHROOM</text>
        <view class="tag-grid">
          <block a:for="{{room.bathAmenities}}">
            <view class="tag-gray">
              <text class="tag-text">• {{item}}</text>
            </view>
          </block>
        </view>
      </view>
      
      <view class="spacer-bottom" />
    </view>
  </scroll-view>

  <view class="footer-action">
    <view class="price-group">
      <text class="price-label">TOTAL PRICE</text>
      <text class="price-value">Rp {{room.pricePerNight}}</text>
    </view>
    <view class="btn-book" onTap="onBookTap">
      <text class="btn-text">Book This Room</text>
    </view>
  </view>
</view>