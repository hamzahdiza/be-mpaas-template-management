.container-index {
  background-color: #f8fafc;
  min-height: 100vh;
  position: relative;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.header-search {
  padding: 48px 20px 16px;
  background-color: white;
  position: sticky;
  top: 0;
  z-index: 20;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: #f1f5f9;
  padding: 10px 16px;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
}

.search-placeholder {
  font-size: 14px;
  color: #94a3b8;
  font-weight: 500;
}

.content-scroll {
  padding: 0 20px 120px;
}

.banner-card {
  position: relative;
  height: 192px;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  margin-top: 24px;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  padding: 16px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.banner-tags {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.tag-promo {
  background-color: #10b981;
  color: white;
  font-size: 10px;
  font-weight: 900;
  padding: 2px 8px;
  border-radius: 4px;
  letter-spacing: 0.05em;
}

.tag-category {
  color: white;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  opacity: 0.8;
}

.merchant-name-banner {
  color: white;
  font-size: 24px;
  font-weight: 900;
  letter-spacing: -0.025em;
  line-height: 1.2;
}

.info-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid #f1f5f9;
  margin-bottom: 24px;
}

.rating-info {
  display: flex;
  align-items: center;
  gap: 8px;
}

.stars {
  display: flex;
  gap: 2px;
}

.star-active { color: #fbbf24; font-size: 12px; }
.star-inactive { color: #cbd5e1; font-size: 12px; }

.rating-val {
  font-size: 12px;
  font-weight: 700;
  color: #0f172a;
}

.rating-count {
  font-size: 10px;
  color: #94a3b8;
  font-weight: 500;
}

.halal-badge {
  background-color: #ecfdf5;
  color: #059669;
  font-size: 10px;
  font-weight: 900;
  padding: 4px 8px;
  border-radius: 6px;
  text-transform: uppercase;
}

.category-filter {
  display: flex;
  white-space: nowrap;
  padding: 4px 0;
  margin-bottom: 24px;
}

.filter-item {
  display: inline-block;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  margin-right: 8px;
  background-color: white;
  border: 1px solid #e2e8f0;
  color: #64748b;
  transition: all 0.2s;
}

.filter-item.active {
  background-color: #059669;
  color: white;
  border-color: #059669;
  box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.2);
}

.menu-section {
  margin-top: 8px;
}

.section-title {
  font-size: 16px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.025em;
  margin-bottom: 16px;
  display: block;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.menu-card {
  display: flex;
  gap: 16px;
  padding: 16px;
  background-color: white;
  border-radius: 16px;
  border: 1px solid #f1f5f9;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.menu-img-container {
  position: relative;
  width: 96px;
  height: 96px;
  border-radius: 12px;
  overflow: hidden;
  flex-shrink: 0;
}

.menu-img {
  width: 100%;
  height: 100%;
}

.add-icon-small {
  position: absolute;
  top: 4px;
  right: 4px;
  background-color: rgba(255,255,255,0.9);
  color: #059669;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  box-shadow: 0 1px 2px rgba(0,0,0,0.1);
}

.menu-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 2px 0;
}

.menu-name {
  font-size: 14px;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 4px;
}

.menu-desc {
  font-size: 10px;
  color: #64748b;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.menu-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.menu-price {
  font-size: 14px;
  font-weight: 900;
  color: #059669;
}

.add-btn-small {
  background-color: #ecfdf5;
  color: #059669;
  font-size: 10px;
  font-weight: 900;
  padding: 6px 12px;
  border-radius: 8px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cart-bar {
  position: fixed;
  bottom: 40px;
  left: 20px;
  right: 20px;
  background-color: #059669;
  padding: 16px;
  border-radius: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 20px 25px -5px rgba(16, 185, 129, 0.2);
  z-index: 30;
}

.cart-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.cart-icon-container {
  position: relative;
}

.cart-icon {
  width: 24px;
  height: 24px;
}

.cart-count {
  position: absolute;
  top: -4px;
  right: -4px;
  background-color: #f43f5e;
  color: white;
  font-size: 8px;
  font-weight: 900;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-text {
  display: flex;
  flex-direction: column;
}

.cart-label {
  color: white;
  font-size: 12px;
  font-weight: 900;
  line-height: 1;
  margin-bottom: 2px;
}

.cart-merchant {
  color: rgba(255,255,255,0.8);
  font-size: 10px;
  line-height: 1;
}

.cart-total {
  color: white;
  font-size: 14px;
  font-weight: 900;
}
