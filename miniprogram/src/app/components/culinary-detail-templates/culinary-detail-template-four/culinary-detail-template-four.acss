.container-detail-elegant {
  background-color: #faf9f6;
  min-height: 100vh;
  padding-bottom: 128px;
  font-family: 'Times New Roman', Times, serif;
}

.elegant-detail-inner {
  padding: 40px;
}

.back-btn-text-elegant {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 64px;
  padding-top: 16px;
}

.arrow-elegant {
  font-size: 24px;
  font-weight: 300;
  color: #94a3b8;
}

.btn-label-elegant {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
}

.item-hero-elegant {
  position: relative;
  width: 100%;
  aspect-ratio: 3/4;
  margin-bottom: 64px;
  box-shadow: 0 48px 96px -12px rgba(0, 0, 0, 0.25);
}

.hero-img-elegant {
  width: 100%;
  height: 100%;
}

.hero-overlay-elegant {
  position: absolute;
  inset: 0;
  background-color: rgba(0,0,0,0.05);
}

.elegant-detail-info {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.info-header-elegant {
  text-align: center;
}

.info-tag-elegant {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 24px;
  display: block;
}

.item-name-elegant-detail {
  font-size: 48px;
  font-style: italic;
  color: #0f172a;
  line-height: 0.8;
  letter-spacing: -0.05em;
  margin-bottom: 32px;
  display: block;
}

.accent-divider-elegant {
  width: 48px;
  height: 1px;
  background-color: #0f172a;
  margin: 0 auto;
}

.item-desc-elegant {
  font-size: 16px;
  line-height: 1.6;
  color: #475569;
  text-align: center;
  font-style: italic;
  max-width: 320px;
  margin: 0 auto;
}

.elegant-action-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48px;
  padding-top: 64px;
}

.price-container-elegant {
  text-align: center;
}

.price-label-elegant {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 8px;
  display: block;
}

.price-val-elegant {
  font-size: 28px;
  font-style: italic;
  color: #0f172a;
}

.place-order-btn-elegant {
  width: 100%;
  padding: 24px;
  background-color: #0f172a;
  color: white;
  text-align: center;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}
