    width: 340px;
    height: 100%;
    border-radius: 8px 8px 0px 0px;
    background-color: #f0f0f0;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
  }

  .partner-image-1-skeleton {
    width: 100%;
    height: 100%;
    border-radius: 8px 8px 0px 0px;
    background-color: #f0f0f0;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
  }

  .partner-content-container {
    display: flex;
    width: calc(340px - 24px);
    padding: var(--Spacing-Spacing-3---12px, 12px);
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
    border-radius: 0px 0px 8px 8px;
  }

  .partner-tag-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
  }

  .partner-title-subtitle {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
  }

  .partner-title-teks {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    align-self: stretch;
    overflow: hidden;
    color: var(--functional-bw-tones-black, #0E0E0E);
    font-feature-settings: 'liga'off, 'clig'off;
    text-overflow: ellipsis;

    /* Mobile/Headline/Headline 5 - Bold */
    font-family: "TT Interphases Pro";
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    /* 16.8px */
    margin-bottom: 8px;

  }

  .partner-subtitle-teks {
    width: 100%;

    color: var(--functional-bw-tones-granite-gray, #7A7A7A);
    font-feature-settings: 'liga'off, 'clig'off;
    text-overflow: ellipsis;
    white-space: normal;

    /* Mobile/Label/Label 3 - Regular */
    font-family: "TT Interphases Pro";
    font-size: 10px;
    font-style: normal;
    font-weight: 400;
    line-height: 120%;
    /* 12px */

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    max-height: 25px;
  }

  .partner-price-ratings {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
  }

  .partner-price-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
  }

  .partner-price {
    display: flex;
    align-items: center;
  }

  .partner-price-text-1-discount {
    color: var(--Brand-BNI-Orange-Orange-400, #FA6805);
    font-feature-settings: 'liga'off, 'clig'off;

    /* Mobile/Headline/Headline 5 - Bold */
    font-family: "TT Interphases Pro";
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    /* 16.8px */
  }

  .partner-price-text-1 {
    color: var(--Brand-BNI-Orange-Orange-400, #0E0E0E);
    font-feature-settings: 'liga'off, 'clig'off;

    /* Mobile/Headline/Headline 5 - Bold */
    font-family: "TT Interphases Pro";
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 120%;
    /* 16.8px */
  }

  .partner-price-text-2 {
    color: var(--functional-bw-tones-granite-gray, #7A7A7A);
    font-feature-settings: 'liga'off, 'clig'off;
    font-family: "TT Interphases Pro";
    font-size: 10px;
    font-style: normal;
    font-weight: 400;
    line-height: 120%;
    /* 12px */
    text-decoration-line: line-through;
    margin-left: 4px;
  }

  .content-secondary-tabs {
    width: 16px;
    height: 16px;
    display: flex;
    padding: 4px var(--Rounded-Corner-Small---8px, 8px);
    justify-content: center;
    align-items: center;
    position: absolute;
    right: 12px;
    top: 12px;
    border-radius: var(--Rounded-Corner-Medium---16px, 16px);
    background: var(--functional-bw-tones-white, #FFF);
  }

  .content-secondary-tabs-1 {
    width: fit-content;
    height: 16px;
    display: flex;
    padding: 4px var(--Rounded-Corner-Small---8px, 8px);
    justify-content: center;
    align-items: center;
    position: absolute;
    right: 12px;
    top: 12px;
    border-radius: var(--Rounded-Corner-Medium---16px, 16px);
    background: var(--functional-bw-tones-white, #FFF);
  }

  .content-secondary-tabs-image {
    width: 16px;
    height: 16px;
  }

  .content-secondary-tabs-text {
    color: var(--Illustration-Purple-Purple-3---Shadow-1, #7863C6);
    text-align: center;
    font-feature-settings: 'liga'off, 'clig'off;

    /* Mobile/Label/Label 3 - DemiBold */
    font-family: "TT Interphases Pro";
    font-size: 10px;
    font-style: normal;
    font-weight: 600;
    line-height: 120%;
    /* 12px */
    margin-right: 4px;
    margin-left: 4px;
    text-transform: capitalize;
  }


  .image-circle {
    width: 180px;
    height: 210px;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    right: 0px;
  }
}

@media (max-width: 375px) {
  .image-circle {
    width: 180px;
    height: 210px;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    right: 26px;
  }

  .image-gif {
    width: 180px;
    height: 140px;
    position: relative;
    right: 0;
    top: 35px;
  }

  .image-lottery-content {
    width: 129px;
    height: 97px;
    position: absolute;
    z-index: 100;
    right: 5px;
    top: 70px;
    /* background-color: red; */
    perspective: 1000px;
  }

  .image-gif {
    width: 180px;
    height: 140px;
    position: relative;
    right: 0;
    top: 35px;
  }

  .image-anim {
    /* position: absolute; */
    width: 110px;
    height: fit-content;
    justify-content: center;
    align-items: center;
  }
}

/* =========== ALL EVENTS SECTION =========== */

.events-section {
  width: 100%;
  background-color: #ffffff;
  padding-bottom: 8px;
  z-index: 4;
  position: relative;
}

.events-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px 12px 24px;
}

.events-section-title {
  color: #0E0E0E;
  font-family: "TT Interphases Pro";
  font-size: 16px;
  font-weight: 700;
  line-height: 120%;
}

.events-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 0 24px 8px 24px;
}

.event-card {
  display: flex;
  flex-direction: column;
  border-radius: 12px;
  border: 1px solid #EBEBEB;
  overflow: hidden;
  background-color: #ffffff;
  box-shadow: 0px 2px 8px 0px rgba(0, 0, 0, 0.06);
}

.event-banner-wrapper {
  width: 100%;
  height: 180px;
  position: relative;
  overflow: hidden;
  background-color: #f0f0f0;
}

.event-banner-img {
  width: 100%;
  height: 180px;
}

.event-banner-skeleton {
  width: 100%;
  height: 180px;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
}

.event-price-badge {
  position: absolute;
  bottom: 10px;
  left: 12px;
  display: flex;
  flex-direction: column;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 8px;
  padding: 4px 10px;
  z-index: 5;
}

.event-price-badge-label {
  color: rgba(255, 255, 255, 0.80);
  font-family: "TT Interphases Pro";
  font-size: 10px;
  font-weight: 400;
  line-height: 140%;
}

.event-price-badge-amount {
  color: #ffffff;
  font-family: "TT Interphases Pro";
  font-size: 13px;
  font-weight: 700;
  line-height: 120%;
}

.event-info {
  display: flex;
  flex-direction: column;
  padding: 12px;
  gap: 8px;
}

.event-name {
  color: #0E0E0E;
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-weight: 700;
  line-height: 120%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.event-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

.event-meta-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.event-meta-text {
  color: #7A7A7A;
  font-family: "TT Interphases Pro";
  font-size: 12px;
  font-weight: 400;
  line-height: 140%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.events-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32px 0;
  gap: 12px;
}

.events-empty-icon {
  width: 120px;
  height: 80px;
}

.events-empty-text {
  color: #A0A0A0;
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-weight: 400;
  line-height: 140%;
  text-align: center;
}

/* =========== END ALL EVENTS SECTION =========== */