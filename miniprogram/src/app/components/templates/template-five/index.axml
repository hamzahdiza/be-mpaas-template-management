<view class="t5-container">
    <!-- Sticky Header -->
    <view class="t5-header">
        <view class="t5-status-bar"></view>
        <view class="t5-nav-bar">
            <view class="t5-back-btn" onTap="goBack">
                <image src="/src/assets/icons/ic_common_arrow_back.svg" class="t5-back-icon" />
            </view>
            <text class="t5-nav-title">{{detailEvent.eventName}}</text>
            <view class="t5-nav-spacer"></view>
        </view>
    </view>

    <!-- Banner -->
    <view class="t5-banner-container">
        <swiper
          current="{{ currentPoster }}"
          autoplay="{{ true }}"
          duration="1000"
          circular="{{ true }}"
          onChange="onSwipeChangePoster"
          class="t5-swiper"
        >
          <block a:for="{{ detailEvent.banner }}" a:for-index="index" a:for-item="item" a:key="{{ index }}">
            <swiper-item>
              <view class="t5-banner-image" style="background: url('{{ item }}') center / cover no-repeat;" />
            </swiper-item>
          </block>
        </swiper>
    </view>

    <view class="t5-content">
        <!-- Title -->
        <text class="t5-title">{{detailEvent.eventName}}</text>

        <!-- Pills -->
        <view class="t5-pills">
            <view class="t5-pill">
                <image class="t5-icon" src="/src/assets/icons/ic_common_calendar_today.svg" />
                <text class="t5-pill-text">{{formattedDate}}</text>
            </view>
            <view class="t5-pill" onTap="openMap">
                <text class="t5-icon-text">📍</text>
                <text class="t5-pill-text">{{detailEvent.location}}</text>
            </view>
        </view>

        <!-- Socials -->
        <view class="t5-socials" a:if="{{(detailEvent.socials && detailEvent.socials.instagram && detailEvent.socials.instagram.visible) || (detailEvent.socials && detailEvent.socials.website && detailEvent.socials.website.visible) || detailEvent.instagram || detailEvent.website}}" style="display: flex; gap: 12px; margin-top: 16px;">
             <view class="t5-social-pill" a:if="{{(detailEvent.socials && detailEvent.socials.instagram && detailEvent.socials.instagram.visible) || detailEvent.instagram}}" style="display: flex; align-items: center; gap: 6px; background: #F3F4F6; padding: 6px 12px; border-radius: 99px;">
                 <image src="/src/assets/icons/ic_common_instagram.svg" style="width: 14px; height: 14px;" />
                 <text class="t5-social-text" style="font-size: 12px; font-weight: 500;">{{detailEvent.instagram}}</text>
             </view>
             <view class="t5-social-pill" a:if="{{(detailEvent.socials && detailEvent.socials.website && detailEvent.socials.website.visible) || detailEvent.website}}" style="display: flex; align-items: center; gap: 6px; background: #F3F4F6; padding: 6px 12px; border-radius: 99px;">
                 <image src="/src/assets/icons/ic_common_browser.svg" style="width: 14px; height: 14px;" />
                 <text class="t5-social-text" style="font-size: 12px; font-weight: 500;">{{detailEvent.website}}</text>
             </view>
        </view>

        <!-- Description -->
        <view class="t5-description-box">
            <text class="t5-description-text {{isDescExpanded ? '' : 'line-clamp-3'}}">
                {{detailEvent.description}}
            </text>
            <view class="t5-read-more" onTap="toggleDescExpanded">
                <text>{{isDescExpanded ? 'Show Less' : 'Read More'}}</text>
            </view>
        </view>

        <!-- Seating Plan (Template 5) -->
        <view a:if="{{ detailEvent.seatingPlanUrl }}" style="margin-top: 24px;">
            <text style="font-size: 16px; font-weight: 700; color: #111827; margin-bottom: 12px; display: block;">Seating & Venue</text>
            <view style="background: white; padding: 8px; border-radius: 12px; border: 1px solid #E5E7EB; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                <view style="border-radius: 8px; overflow: hidden; position: relative;">
                    <image src="{{detailEvent.seatingPlanUrl}}" mode="widthFix" style="width: 100%; display: block;" />
                </view>
            </view>
        </view>

        <!-- Ticket Packages -->
        <view class="t5-tickets-section">
            <view class="t5-section-title" style="padding-top: 5px">Select Ticket</view>
            <view class="t5-tickets-list">
                <block a:for="{{ticketDataList}}" a:key="{{index}}">
                    <view class="t5-ticket-card" onTap="goToTicketList" data-ticket-data="{{item}}">
                        <view class="t5-ticket-header">
                            <text class="t5-ticket-name">{{item.name}}</text>
                        </view>
                        <text class="t5-ticket-desc">{{item.description}}</text>
                        
                        <view class="t5-ticket-footer">
                            <view>
                                <text class="t5-price-label">Price</text>
                                <view class="t5-price-wrapper">
                                    <text class="t5-price-normal" a:if="{{item.normalPriceFormatted}}">{{item.normalPriceFormatted}}</text>
                                    <text class="t5-price-value">{{item.formatPriceTaxService}}</text>
                                </view>
                            </view>
                            <view class="t5-arrow-btn">
                                <image class="t5-icon-white" src="/src/assets/icons/ic_common_chevron_right.svg" />
                            </view>
                        </view>
                    </view>
                </block>
            </view>
        </view>

        <!-- Terms & Conditions (Template 5: After Tickets) -->
        <view a:if="{{detailEvent.termsAndConditions}}" style="margin-top: 32px;">
            <text style="font-size: 16px; font-weight: 700; color: #111827; margin-bottom: 12px; display: block;">Rules & Regulations</text>
            <view style="background: white; border-radius: 12px; border: 1px solid #E5E7EB; box-shadow: 0 1px 2px rgba(0,0,0,0.05); overflow: hidden;">
                <view style="padding: 16px; background: white;">
                    <text style="font-size: 13px; color: #4B5563; white-space: pre-line; line-height: 1.6; font-family: monospace;">{{detailEvent.termsAndConditions}}</text>
                </view>
            </view>
        </view>
    </view>
</view>
