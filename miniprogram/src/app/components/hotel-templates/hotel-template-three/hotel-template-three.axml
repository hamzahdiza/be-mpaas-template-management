<view class="container-index hotel-eco">
  <view class="eco-hero">
    <image class="eco-hero-img" src="{{data.bannerUrl}}" mode="aspectFill" />
    <view class="eco-hero-overlay" />
    
    <view class="eco-hero-header">
      <view class="eco-badge-float">
        <view class="eco-pulse" />
        <text class="eco-badge-text">Eco-Conscious</text>
      </view>
    </view>

    <view class="eco-hero-bottom">
      <text class="eco-hotel-name">{{data.name}}</text>
      <text class="eco-location-tag">{{data.location}}</text>
    </view>
  </view>

  <view class="eco-content">
    <view class="eco-section-header">
      <text class="eco-section-title">Wild Retreats</text>
      <view class="eco-pagination">
        <view class="eco-page-dot active" />
        <view class="eco-page-dot" />
      </view>
    </view>

    <scroll-view scroll-x="{{true}}" class="eco-rooms-scroll" show-scrollbar="{{false}}">
      <block a:for="{{data.categories}}">
        <view class="eco-room-card" onTap="handleRoomTap" data-item="{{item}}">
          <view class="eco-card-img-container">
            <image class="eco-card-img" src="{{item.images[0]}}" mode="aspectFill" />
            <view class="eco-price-tag">
              <text class="eco-price-text">Rp {{item.pricePerNight.toLocaleString('id-ID')}}</text>
            </view>
          </view>
          <view class="eco-card-info">
            <text class="eco-room-name">{{item.name}}</text>
            <text class="eco-room-meta">{{item.roomType}} 👤 {{item.capacity}} Guests</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
