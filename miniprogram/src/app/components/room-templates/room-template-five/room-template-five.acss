.container-detail-vintage {
  background-color: #faf7f2;
  min-height: 100vh;
  padding-bottom: 96px;
  font-family: 'Times New Roman', Times, serif;
}

.vintage-detail-body {
  padding: 40px;
}

.vintage-detail-header {
  margin-bottom: 80px;
  padding-top: 16px;
}

.vintage-back-btn-text {
  display: flex;
  align-items: center;
  gap: 16px;
}

.vintage-arrow-large {
  font-size: 24px;
  font-weight: 300;
  color: #8c7b6e;
}

.vintage-btn-label-large {
  font-size: 10px;
  font-weight: 900;
  color: #8c7b6e;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
}

.vintage-hero-room-arch {
  position: relative;
  aspect-ratio: 3/4;
  border-top-left-radius: 999px;
  border-top-right-radius: 999px;
  overflow: hidden;
  border: 16px solid white;
  box-shadow: 0 64px 96px -12px rgba(74, 62, 55, 0.3);
  margin-bottom: 80px;
}

.vintage-room-img-arch {
  width: 100%;
  height: 100%;
}

.vintage-info-section-arch {
  text-align: center;
  max-width: 320px;
  margin: 0 auto;
}

.vintage-tag-arch {
  font-size: 10px;
  font-weight: 900;
  color: #8c7b6e;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  opacity: 0.6;
  margin-bottom: 40px;
  display: block;
}

.vintage-room-name-arch {
  font-size: 60px;
  font-style: italic;
  color: #4a3e37;
  line-height: 0.85;
  letter-spacing: -0.05em;
  margin-bottom: 40px;
  display: block;
}

.vintage-accent-divider-arch {
  width: 80px;
  height: 1px;
  background-color: #8c7b6e;
  margin: 0 auto 48px;
}

.vintage-room-desc-arch {
  font-size: 16px;
  line-height: 1.6;
  color: #6b5e55;
  font-style: italic;
  padding: 0 16px;
  display: block;
}

.vintage-action-section-arch {
  margin-top: 96px;
  padding-top: 96px;
  border-top: 1px solid rgba(140, 123, 110, 0.1);
  display: flex;
  flex-direction: column;
  gap: 48px;
}

.vintage-price-col-arch {
  text-align: center;
}

.vintage-price-label-arch {
  font-size: 10px;
  font-weight: 900;
  color: #8c7b6e;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 16px;
  display: block;
}

.vintage-price-val-arch {
  font-size: 36px;
  font-style: italic;
  color: #4a3e37;
}

.vintage-request-btn-arch {
  width: 100%;
  padding: 28px;
  background-color: #4a3e37;
  color: #faf7f2;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}
