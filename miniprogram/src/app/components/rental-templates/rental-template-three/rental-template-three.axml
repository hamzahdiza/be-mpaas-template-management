<view class="rental-v3-container">
  <view class="dark-header">
    <text class="brand-text">{{data.name}}</text>
    <view class="status-dot">
      <view class="dot"></view>
      <text>ONLINE NOW</text>
    </view>
  </view>

  <view class="search-bar-v3">
    <icon type="search" size="16" color="#888" />
    <text>Search your dream ride...</text>
  </view>

  <view class="featured-scroll">
    <text class="label">TOP PICKS</text>
    <scroll-view scroll-x="{{true}}" class="h-scroll">
      <block a:for="{{data.vehicles}}">
        <view class="featured-card" onTap="onVehicleTap" data-item="{{item}}">
          <image src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="overlay">
            <text class="f-name">{{item.name}}</text>
            <text class="f-price">Rp {{item.pricePerDay.toLocaleString('id-ID')}}</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="full-list">
    <text class="label">ALL FLEETS</text>
    <block a:for="{{data.vehicles}}">
      <view class="list-item" onTap="onVehicleTap" data-item="{{item}}">
        <image src="{{item.imageUrl}}" mode="aspectFill" class="li-img" />
        <view class="li-info">
          <text class="li-name">{{item.name}}</text>
          <view class="li-specs">
            <text>{{item.type}}</text>
            <text>ΓÇó</text>
            <text>{{item.transmission}}</text>
          </view>
          <text class="li-price">Rp {{item.pricePerDay.toLocaleString('id-ID')}}</text>
        </view>
        <view class="li-btn">
          <image src="https://img.icons8.com/ios-glyphs/30/ffffff/forward.png" />
        </view>
      </view>
    </block>
  </view>
</view>
