.container-detail-hotel-modern {
  background-color: white;
  min-height: 100vh;
  padding-bottom: 120px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.hero-room-modern {
  position: relative;
  height: 55vh;
}

.hero-img-room {
  width: 100%;
  height: 100%;
}

.hero-overlay-room {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, white, transparent, rgba(0,0,0,0.2));
}

.back-btn-room {
  position: absolute;
  top: 48px;
  left: 24px;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  z-index: 10;
}

.detail-body-room {
  padding: 40px 32px;
}

.header-room-modern {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32px;
}

.header-left-room {
  flex: 1;
  padding-right: 24px;
}

.tag-room-modern {
  font-size: 10px;
  font-weight: 900;
  color: #2563eb;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  margin-bottom: 8px;
  display: block;
  font-style: italic;
}

.room-name-detail {
  font-size: 32px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  line-height: 0.85;
  text-transform: uppercase;
  font-style: italic;
}

.header-right-room {
  text-align: right;
}

.price-val-detail {
  font-size: 20px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  display: block;
  line-height: 1;
}

.price-unit-detail {
  font-size: 10px;
  font-weight: 700;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-top: 4px;
  display: block;
}

.amenities-scroll {
  display: flex;
  white-space: nowrap;
  padding: 32px 0;
  border-top: 1px solid #f8fafc;
  border-bottom: 1px solid #f8fafc;
  margin-bottom: 40px;
}

.amenity-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  background-color: #f8fafc;
  padding: 16px 24px;
  border-radius: 32px;
  margin-right: 16px;
  min-width: 100px;
  border: 1px solid #f1f5f9;
}

.amenity-icon {
  font-size: 18px;
  opacity: 0.4;
}

.amenity-text {
  font-size: 10px;
  font-weight: 900;
  color: #0f172a;
  text-transform: uppercase;
  letter-spacing: -0.025em;
}

.desc-room-section {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.label-room-modern {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 0.3em;
}

.desc-room-text {
  font-size: 16px;
  line-height: 1.6;
  color: #64748b;
  font-weight: 500;
  font-style: italic;
}

.footer-action-room {
  position: fixed;
  bottom: 48px;
  left: 32px;
  right: 32px;
  z-index: 50;
}

.reserve-btn-modern {
  background-color: #2563eb;
  color: white;
  padding: 24px;
  border-radius: 40px;
  text-align: center;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  box-shadow: 0 25px 50px -12px rgba(37, 99, 235, 0.3);
}
