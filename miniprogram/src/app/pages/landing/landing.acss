  /* 12px */
}

.ur-promo-content-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  align-self: stretch;
  overflow: hidden;
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;
  text-overflow: ellipsis;

  /* Mobile/Headline/Headline 5 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 16.8px */
  margin-bottom: 8px;
  ;
}

.ur-promo-content-description {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  align-self: stretch;
  overflow: hidden;
  color: var(--functional-bw-tones-black, #0E0E0E);
  font-feature-settings: 'liga'off, 'clig'off;
  text-overflow: ellipsis;

  /* Mobile/Label/Label 3 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 10px;
  font-style: normal;
  font-weight: 400;
  line-height: 120%;
  /* 12px */
}

.image-circle {
  width: 180px;
  height: 210px;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  right: -2px;
}

.image-gif {
  width: 180px;
  height: 140px;
  position: relative;
  right: 0;
  top: 35px;
}

.image-lottery-content {
  width: 129px;
  height: 97px;
  position: absolute;
  z-index: 100;
  right: 6px;
  top: 65px;
  /* background-color: red; */
  perspective: 1000px;
}

.image-anim {
  /* position: absolute; */
  width: 120px;
  height: fit-content;
  justify-content: center;
  align-items: center;
}

.image-anim.depth {
  animation: depth-animation 0.8s ease-in forwards, depth-animation-loop 1.2s ease-in-out infinite alternate 1.5s;
}

@keyframes depth-animation {
  0% {
    transform: translate3d(0, 0, -500px);
  }

  25% {
    transform: translate3d(0, 0, 60px);
  }

  50% {
    transform: translate3d(0, 0, -30px);
  }

  75% {
    transform: translate3d(0, 0, 40px);
  }

  100% {
    transform: translate3d(0, 0, -10px);
  }
}

@keyframes depth-animation-loop {
  0% {
    transform: translate3d(0, 0, -10px);
  }

  100% {
    transform: translate3d(0, 0, 40px);
  }
}

.ant-popup-content {
  display: grid;
  flex-direction: column;
}

