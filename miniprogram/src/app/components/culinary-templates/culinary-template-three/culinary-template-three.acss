.container-luxury {
  background-color: #ffffff;
  min-height: 100vh;
}

.header-immersive {
  height: 450px;
  width: 100%;
  position: relative;
}

.image-slider {
  width: 100%;
  height: 100%;
}

.header-swiper {
  height: 450px;
  width: 100%;
}

.overlay-gradient {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, transparent 40%, #ffffff 100%);
  z-index: 1;
}

.header-content-center {
  position: absolute;
  top: 100px;
  width: 100%;
  text-align: center;
  z-index: 2;
}

.luxury-tag {
  color: rgba(255, 255, 255, 0.8);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-weight: 300;
  display: block;
  margin-bottom: 8px;
}

.hotel-name-serif {
  color: #ffffff;
  font-size: 36px;
  font-style: italic;
  font-weight: 400;
  /* Menggunakan font-family serif jika tersedia di device, fallback ke standard */
  font-family: serif, "Times New Roman"; 
}

/* CONTENT OVERLAP */
.content-overlap {
  padding: 0 32px 32px 32px;
  margin-top: -80px;
  position: relative;
  z-index: 10;
}

.card-luxury-main {
  background-color: #ffffff;
  border-radius: 48px;
  padding: 32px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
  border: 1px solid #f8fafc;
}

.suite-selection-title {
  color: #0f172a;
  font-weight: bold;
  font-size: 18px;
  margin-bottom: 24px;
  text-align: center;
  display: block;
}

/* SUITE GRID */
.suite-grid {
  display: grid;
  grid-template-columns: 1fr;
  grid-gap: 40px; /* Spacing vertikal yang besar sesuai template aslinya */
}

.suite-item {
  text-align: center;
}

.suite-img-wrapper {
  width: 100%;
  height: 192px;
  border-radius: 32px;
  overflow: hidden;
  margin-bottom: 16px;
  box-shadow: 0 8px 16px rgba(0,0,0,0.05);
}

.suite-img {
  width: 100%;
  height: 100%;
}

.suite-name {
  color: #1e293b;
  font-weight: 900;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  display: block;
}

.suite-price-italic {
  color: #b45309; /* Amber-600 */
  font-size: 14px;
  font-style: italic;
  margin-top: 4px;
  display: block;
  font-family: serif;
}

.animate-in {
  animation: fadeIn 0.7s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}