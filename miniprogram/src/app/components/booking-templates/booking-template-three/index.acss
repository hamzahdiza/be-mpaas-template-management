.container-result {
  height: 100vh;
  background-color: #F8F9FA;
}

.m-t-16 {
  margin-top: 16px;
}

.m-b-16 {
  margin-bottom: 16px;
}

.m-y-8 {
  margin-left: 8px;
  margin-right: 8px;
}

.container-book {
  padding: 0 24px;
}

/* Professional Card Style - Horizontal */
.ticket-pro {
  position: relative;
  background: var(--white);
  color: var(--black);
  border-radius: 8px;
  padding: 16px;
  border: 1px solid #EDEDED;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  margin-bottom: 12px;
}

/* Disabled state */
.ticket-pro.disabled {
    opacity: 0.6;
    background-color: #FAFAFA;
}

.bottom-container {
  background-color: var(--white);
  position: fixed;
  bottom: 0;
  width: calc(100% - 48px);
  padding: 16px 24px 32px 24px;
  box-shadow: 0px -4px 16px 0px rgba(0, 0, 0, 0.08);
}

.sticky-top {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: #ffffff;
  border-bottom: 1px solid #EDEDED;
}

.card-description-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.left-section {
    flex: 1;
    padding-right: 12px;
}

.right-section {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 100px;
}

.bottom-container-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.disabled-icon {
    opacity: 0.3;
}

.icon-size-24 {
  width: 24px;
  height: 24px;
}

/* Premium Segmented Tab Style */
.tab-segmented {
  display: flex;
  background-color: #E9ECEF;
  border-radius: 12px;
  padding: 4px;
  margin-top: 24px;
  margin-bottom: 8px;
}

.tab-pill {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  border-radius: 9px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-pill.active {
  background-color: #FFFFFF;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  color: #0E0E0E;
  font-weight: 700;
}

.tab-pill.inactive {
  color: #6C757D;
  font-weight: 500;
}

.tab-text {
  font-size: 14px;
}

.txt-h4-pro {
    font-size: 18px;
    font-weight: 700;
    color: #0E0E0E;
    letter-spacing: 0.5px;
}

.txt-price-pro {
    font-size: 16px;
    font-weight: 700;
    color: #0E0E0E;
}
