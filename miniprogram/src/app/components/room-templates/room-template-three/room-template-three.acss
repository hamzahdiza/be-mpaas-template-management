.container-detail-eco {
  background-color: #fafdfb;
  min-height: 100vh;
  padding: 32px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.eco-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 64px;
  padding-top: 16px;
}

.eco-back-btn {
  width: 56px;
  height: 56px;
  background-color: #ecfdf5;
  border-radius: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.eco-essence-label {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-style: italic;
}

.eco-icon-btn {
  width: 56px;
  height: 56px;
  background-color: #059669;
  border-radius: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.3);
}

.eco-icon-leaf {
  font-size: 24px;
}

.eco-detail-body {
  display: flex;
  flex-direction: column;
}

.eco-item-img-container {
  position: relative;
  margin-bottom: 64px;
}

.eco-img-accent {
  position: absolute;
  inset: 0;
  background-color: #059669;
  border-radius: 80px;
  transform: rotate(3deg) scale(0.95);
  opacity: 0.05;
}

.eco-item-img {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 80px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}

.eco-info-section {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.eco-item-name-detail {
  font-size: 40px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  line-height: 0.8;
  text-transform: uppercase;
  font-style: italic;
  display: block;
}

.eco-price-rating-row {
  display: flex;
  align-items: center;
  gap: 24px;
}

.eco-price-badge {
  background-color: #059669;
  padding: 16px 32px;
  border-radius: 32px;
  box-shadow: 0 20px 25px -5px rgba(5, 150, 105, 0.3);
}

.eco-price-val {
  color: white;
  font-size: 24px;
  font-weight: 900;
  letter-spacing: -0.05em;
  font-style: italic;
}

.eco-avatars {
  display: flex;
  align-items: center;
}

.eco-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid white;
  margin-left: -8px;
}

.eco-avatar:first-child {
  margin-left: 0;
}

.eco-avatar-more {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: #ecfdf5;
  border: 2px solid white;
  margin-left: -8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 900;
  color: #059669;
}

.eco-desc-container {
  display: flex;
  gap: 24px;
}

.eco-desc-line {
  width: 4px;
  background-color: #ecfdf5;
  flex-shrink: 0;
}

.eco-item-desc {
  font-size: 18px;
  font-weight: 500;
  color: #64748b;
  line-height: 1.6;
  font-style: italic;
}

.eco-footer-action {
  margin-top: 48px;
}

.eco-request-btn {
  width: 100%;
  padding: 24px;
  background-color: #0f172a;
  color: white;
  border-radius: 40px;
  text-align: center;
  font-size: 20px;
  font-weight: 900;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
  text-transform: uppercase;
  letter-spacing: -0.025em;
  font-style: italic;
}
