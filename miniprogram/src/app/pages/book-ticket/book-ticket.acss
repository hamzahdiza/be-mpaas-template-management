.container-result {
  height: 100vh;
}

.m-t-16 {
  margin-top: 16px;
}

.m-y-8 {
  margin-left: 8px;
  margin-right: 8px;
}

.container-book {
  padding: 0 24px;
}

.ticket {
  position: relative;
  border: 1px solid var(--purple-300);
  background: var(--white);
  color: var(--black);
  display: inline-block;
  /* padding: 1em 2em; */
  width: calc(100% - 32px);
  border-radius: 8px;
  padding: 0 16px;
}

.ticket:before,
.ticket:after {
  /* height: 80px; */
  /* width:100%; */
  content: '';
  position: absolute;
  background-color: var(--white) !important;
  bottom: 40px;
  height: 15px;
  width: 10px;
  border: 1px solid var(--purple-300);
}

.ticket:before {
  left: -1.5px;
  border-radius: 0 99px 99px 0;
  background-color: var(--white) !important;
  border-left-color: white;
}

.ticket:after {
  right: -1.5px;
  border-radius: 99px 0 0 99px;
  background-color: var(--white) !important;
  border-right-color: white;
}

.bottom-container {
  background-color: var(--white);
  position: fixed;
  bottom: 0;
  width: calc(100% - 48px);
  padding: 16px 24px 32px 24px;
  box-shadow: 0px -3px 10px 0px rgba(78, 78, 78, 0.15);
}

.resize-indicator {
  width: 34px;
  height: 3px;
  border-radius: 3px;
}


.sticky-top {
  position: sticky;
  top: 0;
}

.card-description {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  padding: 12px 0;
}

.bottom-container-text {
  display: flex;
  justify-content: space-between;
}

.line-image {
  border-top: 2px dashed var(--pale-gray);
  margin: 12px 0;
}

.card-footer {
  display: flex;
  justify-content: space-between;
}


.count-width {
  min-width: 20px;
  text-align: center;
}

.divider {
  height: 1px;
  background-image: url("data:image/svg+xml,%3csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3e%3crect width='100%25' height='100%25' fill='none' stroke='%23DADADA' stroke-width='4' stroke-dasharray='6%2c 10' stroke-dashoffset='0' stroke-linecap='round'/%3e%3c/svg%3e");
  background-size: 10px 10px;
}

.icon {
  background-image: url('/src/assets/icons/Spinner.svg');
  background-size: 200px 200px;
  width: 200px;
  height: 200px;

}

.title-description {
  display: grid;
  flex-direction: column;
  grid-template-columns: auto;
  align-items: flex-start;
  gap: 4px;
  align-self: stretch;
}

.txt-chip-promo {
  color: var(--black, #0E0E0E);
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Label/Label 3 - DemiBold */
  font-family: "TT Interphases Pro";
  font-size: 9.5px;
  font-style: normal;
  font-weight: 600;
  line-height: 120%;
}

.header-title {
  display: flex;
  justify-content: space-between;
}

.strikethrough {
  text-decoration: line-through;
  color: var(--functional-bw-tones-granite-gray, #7A7A7A);
  font-feature-settings: 'liga'off, 'clig'off;
  font-family: "TT Interphases Pro";
  font-size: 10px;
  font-style: normal;
  font-weight: 400;
  line-height: 12px;
  /* 12px */
  margin-left: 4px;
}

.snackbar-container {
  top: 2% !important;
}

.toast-container-out {
  animation: toast-out 0.255s forwards;
}

@keyframes toast-out {
  from {
    opacity: 1
  }

  to {
    opacity: 0;
  }
}

.toast-container-in {
  animation: toast-in 0.25s forwards;
}

@keyframes toast-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}


.icon-size-24 {
  width: 24px;
  height: 24px;
}

.disabled-icon {
  opacity: 0.3;
}

.disabled {
  display: flex;
  position: relative;
  border: 1px solid var(--pale-gray);
  background-color: var(--off-white);
  color: var(--light-gray);
  display: inline-block;
  /* padding: 1em 2em; */
  width: calc(100% - 32px);
  border-radius: 10px;
  padding: 0 16px;
}

.disabled:before,
.disabled:after {
  /* height: 90px; */
  /* width:100%; */
  content: '';
  position: absolute;
  bottom: 40px;
  height: 15px;
  width: 10px;
  border: 1px solid var(--pale-gray);
}

.disabled:before {
  left: -1px;
  border-radius: 0 99px 99px 0;
  background-color: var(--white);
  border-left-color: var(--white);
}

.disabled:after {
  right: -1px;
  border-radius: 99px 0 0 99px;
  background-color: var(--white);
  border-right-color: var(--white);
}

.min-height {
  height: 24px;
}

.ic-remove {
  width: 24px;
  height: 24px;
}

.dash {
  height: 2px;
  width: 100%
}

.p-10 {
  padding: 5px;
}

.m-x-8 {
  margin-top: 8px;
  margin-bottom: 8px;
}

.m-b-24 {
  margin-bottom: 24px;
}

.m-b-8 {
  margin-bottom: 8px;
}

.upSize {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
}

.upSize.open {
  transition: max-height 2s ease-out;
  max-height: 100%;
  opacity: 1;
}

.upSize.close {
  max-height: 0;
  opacity: 0;
}

.circle {
  width: 2px;
  height: 2px;
  border-radius: 50%;
}


@media (min-width: 600px) {
  .container-book {
    padding: 0 24px;
  }

  .ticket {
    position: relative;
    border: 1px solid var(--purple-300);
    background: white;
    color: black;
    display: inline-block;
    /* padding: 1em 2em; */
    width: calc(100% - 43px);
    border-radius: 10px;
    padding: 0 16px;
  }

  .ticket:before,
  .ticket:after {
    height: 90px;
    /* width:100%; */
    content: '';
    position: absolute;
    background-color: var(--white) !important;
    bottom: 40px;
    height: 15px;
    width: 10px;
    border: 1px solid var(--purple-300);
  }

  .ticket:before {
    left: -1.5px;
    border-radius: 0 99px 99px 0;
    background-color: var(--white) !important;
    border-left-color: white;
  }

  .ticket:after {
    right: -1.5px;
    border-radius: 99px 0 0 99px;
    background-color: var(--white) !important;
    border-right-color: white;
  }

  .bottom-container {
    background-color: white;
    position: fixed;
    bottom: 0;
    width: calc(100% - 48px);
    padding: 16px 24px 32px 24px;
    box-shadow: 0px -3px 10px 0px rgba(78, 78, 78, 0.15);
  }

  .resize-indicator {
    width: 36px;
    height: 5px;
    border-radius: 5px;
  }

}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(14, 14, 14, 0.8);
  z-index: 999999999;
  display: flex;
  align-items: center;
  justify-content: center;
}


.ex-card {
  margin-top: 20px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  /* background-color: yellow; */
}

.midle {
  width: 100%;
  height: 113px;
  border-top: 1px solid #9B7EDC;
  border-bottom: 1px solid #9B7EDC;
}

.ex-left {
  /* height: 100%; */
  width: 16px;
}

.ex-right {
  /* height: 100%; */
  width: 16px;
}

.tab-filter {
  display: flex;
  margin-top: 16px;
}

.tab-content {
  padding: 6px 16px;
  border-radius: 16px;
  border-style: solid;
  border-width: 1px;
  margin-right: 8px;
}

.bni-chip {
  display: flex;
  padding: 5.5px 8px;
  justify-content: center;
  align-items: center;
  border-radius: var(--Rounded-Corner-Medium---16px, 16px);
}

.ticket-desc {
  padding-bottom: 24px;
}