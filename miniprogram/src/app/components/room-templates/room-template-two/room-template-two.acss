.container-detail-boutique {
  background-color: #f8f5f2;
  min-height: 100vh;
  padding-bottom: 96px;
  font-family: 'Times New Roman', Times, serif;
}

.boutique-detail-inner {
  padding: 40px;
}

.boutique-back-btn {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 80px;
  padding-top: 16px;
}

.boutique-arrow {
  font-size: 24px;
  font-weight: 300;
  color: #94a3b8;
}

.boutique-btn-label {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
}

.boutique-hero-room {
  position: relative;
  aspect-ratio: 4/5;
  margin-bottom: 80px;
  box-shadow: 0 48px 96px -12px rgba(0, 0, 0, 0.25);
}

.boutique-room-img {
  width: 100%;
  height: 100%;
}

.boutique-room-border {
  position: absolute;
  inset: 0;
  border: 24px solid rgba(248, 245, 242, 0.05);
}

.boutique-detail-content {
  text-align: center;
  max-width: 320px;
  margin: 0 auto;
}

.boutique-room-name-detail {
  font-size: 60px;
  font-style: italic;
  color: #0f172a;
  line-height: 0.8;
  letter-spacing: -0.05em;
  margin-bottom: 32px;
  display: block;
}

.boutique-accent-divider {
  width: 64px;
  height: 1px;
  background-color: #0f172a;
  margin: 0 auto 40px;
}

.boutique-room-desc {
  font-size: 16px;
  line-height: 1.6;
  color: #475569;
  font-style: italic;
  font-family: -apple-system, sans-serif;
}

.boutique-detail-footer {
  margin-top: 80px;
  padding-top: 80px;
  border-top: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.boutique-price-section {
  text-align: left;
}

.boutique-rate-label {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.4em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 8px;
  display: block;
}

.boutique-price-val {
  font-size: 32px;
  font-style: italic;
  color: #0f172a;
  letter-spacing: -0.05em;
}

.boutique-reserve-btn {
  padding: 24px 48px;
  background-color: #0f172a;
  color: white;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}
