.container-urban {
  padding: 16px 24px 24px 24px;
  background-color: #ffffff;
  min-height: 100vh;
}

/* HEADER */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.hotel-name {
  font-size: 26px;
  font-weight: 900;
  color: #1e293b;
  display: block;
  letter-spacing: -0.5px;
}

.location-text {
  color: #94a3b8;
  font-size: 12px;
  margin-top: 4px;
  display: block;
}

.profile-circle {
  width: 40px;
  height: 40px;
  background-color: #f1f5f9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* BANNER */
.banner-wrapper {
  height: 192px;
  border-radius: 40px;
  overflow: hidden;
  margin-bottom: 32px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.banner-swiper {
  height: 100%;
  width: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* TABS */
.tab-scroll {
  white-space: nowrap;
  width: 100%;
}

.tab-container {
  display: flex;
  flex-direction: row;
}

.tab-item {
  padding: 8px 16px;
  border-radius: 100px;
  margin-right: 12px;
}

.active { background-color: #000000; }
.inactive { background-color: #f8fafc; }

.tab-text-active { color: white; font-size: 12px; font-weight: bold; }
.tab-text-inactive { color: #94a3b8; font-size: 12px; font-weight: bold; }

/* ROOM GRID */
.room-grid {
  display: grid;
  grid-template-columns: 1fr;
  grid-gap: 24px; /* Gap aman untuk mPaaS */
  margin-top: 24px;
}

.room-entry {
  position: relative;
  width: 100%;
  height: 224px;
}

.room-img-container {
  width: 100%;
  height: 100%;
  border-radius: 40px;
  overflow: hidden;
}

.room-img {
  width: 100%;
  height: 100%;
}

/* FLOATING INFO BOX */
.floating-info {
  position: absolute;
  bottom: 16px;
  left: 16px;
  right: 16px;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  padding: 16px;
  border-radius: 24px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

.info-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.room-title {
  font-size: 14px;
  font-weight: bold;
  color: #1e293b;
  display: block;
}

.price-row {
  margin-top: 4px;
}

.price-label {
  font-size: 10px;
  color: #64748b;
  font-weight: 500;
}

.price-val {
  font-size: 10px;
  color: #000000;
  font-weight: bold;
}

.black-arrow {
  width: 32px;
  height: 32px;
  background-color: #000000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-text {
  color: white;
  font-size: 12px;
}

.mb-32 { margin-bottom: 32px; }