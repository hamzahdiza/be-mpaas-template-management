.t4-container {
    background-color: #FFFFFF;
    min-height: 100vh;
    padding-bottom: 32px;
}

.t4-back-btn {
    position: fixed;
    top: 48px; /* Status bar height + padding */
    left: 16px;
    width: 40px;
    height: 40px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Removed background/border to match CMS */
}

.t4-back-btn image {
    width: 24px;
    height: 24px;
}

.t4-hero {
    position: relative;
    width: 100%;
    /* aspect-ratio: 4/3; not fully supported in all mp versions, use padding-bottom hack or fixed height */
    height: 0;
    padding-bottom: 75%; /* 4:3 Aspect Ratio */
    background: #F5F5F7;
    overflow: hidden;
}

.t4-swiper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.t4-banner-image {
    width: 100%;
    height: 100%;
}

.t4-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    padding: 24px;
}

.t4-hero-title {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.1;
    display: block;
}

.t4-content {
    padding: 24px;
}

.t4-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    border-bottom: 1px solid #E5E5E5;
    padding-bottom: 32px;
    margin-bottom: 32px;
}

.t4-info-item {
    display: flex;
    flex-direction: column;
}

.t4-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #8E8E93;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.t4-value {
    font-size: 16px;
    font-weight: 500;
    color: #1A1A1A;
}

.t4-sub-value {
    font-size: 12px;
    color: #636366;
    margin-top: 4px;
}

.t4-link {
    /* text-decoration: underline; */
}

.t4-section {
    margin-bottom: 32px;
}

.t4-section-title {
    font-size: 20px;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 12px;
    display: block;
    letter-spacing: -0.5px;
}

.t4-desc-text {
    font-size: 15px;
    line-height: 1.6;
    color: #4A4A4A;
    display: block;
}

.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.t4-read-more {
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
    color: #007AFF;
}

.t4-socials {
    display: flex;
    gap: 16px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid #E5E5E5;
}

.t4-social-link {
    font-size: 13px;
    font-weight: 500;
    color: #1A1A1A;
}

.t4-tickets-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.t4-ticket-card {
    background: #F5F5F7;
    border-left: 4px solid #1A1A1A;
    padding: 20px;
    display: flex;
    flex-direction: column;
}

.t4-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
}

.t4-ticket-name {
    font-size: 18px;
    font-weight: 700;
    color: #1A1A1A;
}

.t4-arrow-circle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
}

.t4-icon-white {
    width: 12px;
    height: 12px;
    filter: invert(1); /* White icon */
}

.t4-ticket-desc {
    font-size: 13px;
    color: #636366;
    margin-bottom: 12px;
    display: block;
}

.t4-card-footer {
    text-align: right;
    border-top: 1px solid #E5E5E5;
    padding-top: 12px;
    width: 100%;
}

.t4-price-label {
    font-size: 11px;
    color: #8E8E93;
    text-transform: uppercase;
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
}

.t4-price-value {
    font-size: 20px;
    font-weight: 700;
    color: #1A1A1A;
}

.t4-back-btn {
    position: absolute;
    top: 50px;
    left: 16px;
    z-index: 100;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
}

.t4-back-btn image {
    width: 24px;
    height: 24px;
}
