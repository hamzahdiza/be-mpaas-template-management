<view class="container-index hotel-modern">
  <view class="hero-hotel">
    <swiper 
      indicator-dots="{{true}}" 
      autoplay="{{true}}" 
      circular="{{true}}"
      indicator-active-color="#ffffff"
      class="hotel-swiper"
    >
      <swiper-item>
        <image class="swiper-img" src="{{data.bannerUrl}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    
    <view class="hero-overlay-hotel" />
    
    <view class="hero-header-hotel">
      <view class="menu-btn-hotel">
        <view class="menu-dot" />
        <view class="menu-dot" />
        <view class="menu-dot" />
      </view>
      <view class="book-now-pill">
        <text class="book-now-text">Book Now</text>
      </view>
    </view>

    <view class="hero-bottom-hotel">
      <view class="stars-hotel">
        <block a:for="{{[1,2,3,4,5]}}" a:for-item="star">
          <text class="star-icon {{star <= data.starRating ? 'active' : ''}}">★</text>
        </block>
      </view>
      <text class="hotel-name-modern">{{data.name}}</text>
      <view class="location-row-hotel">
        <image class="pin-icon" src="https://img.icons8.com/ios-filled/50/3b82f6/marker.png" />
        <text class="location-text-hotel">{{data.location}}</text>
      </view>
    </view>
  </view>

  <view class="content-hotel">
    <view class="desc-section-hotel">
      <text class="section-tag-hotel">Refined Living</text>
      <text class="hotel-desc-text">{{data.description}}</text>
    </view>

    <view class="rooms-section-hotel">
      <view class="section-header-hotel">
        <text class="section-title-hotel">Premium Suites</text>
        <text class="view-all-hotel">VIEW ALL</text>
      </view>

      <view class="rooms-list-hotel">
        <block a:for="{{data.categories}}">
          <view class="room-card-modern" onTap="handleRoomTap" data-item="{{item}}">
            <view class="room-img-container-modern">
              <image class="room-img-modern" src="{{item.images[0]}}" mode="aspectFill" />
              <view class="room-price-badge-modern">
                <text class="room-price-text">Rp {{item.pricePerNight.toLocaleString('id-ID')}}</text>
              </view>
            </view>
            <view class="room-info-modern">
              <text class="room-name-modern">{{item.name}}</text>
              <view class="room-meta-modern">
                <text class="meta-item">{{item.capacity}} Guests</text>
                <view class="meta-dot" />
                <text class="meta-item">{{item.roomType}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
