<view class="nofull">
  <popup visible="{{ generalError}}" maskClassName="mask-class-name-background">
    <view class="d-f-row">
      <view class="h-64 w-64 mg-r-16">
        <image
          mode="scaleToFill"
          src="../../../assets/icons/ic_common_error_filled.svg"
          class="h-64 w-64"
        />
      </view>
      <view class="txt-h3 txt-black d-f-row ai-center">
        {{lang[errorTitle] ? lang[errorTitle] : errorCode + '_errorTitle'}}
      </view>
    </view>
    <view class="mg-b-48 mg-t-16">
      <view class="txt-body2 txt-black">
        {{lang[errorMessage] ? lang[errorMessage] : errorCode + '_errorMessage'}}
      </view>
    </view>
    <view>
      <bni-button class="local-primary-btn txt-black" onTap="change">
        {{lang[errorButton]}}
      </bni-button>
    </view>
  </popup>
</view>