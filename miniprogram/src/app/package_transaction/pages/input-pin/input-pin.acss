.pin-title-container {
  display: grid;
  height: 230px;
  grid-template-rows: auto auto auto;
  align-items: start;
  gap: 56px;
}


.mpin-title-box {
  display: grid;
  padding: 0px 24px;
  grid-auto-flow: row;
  align-items: center;
  gap: 8px;
}

.mpin-input-box-container {
  display: grid;
  padding: 24px 0px;
  grid-auto-flow: row;
  justify-content: center;
  align-items: center;
  gap: 16px;
}

.mpin-input-box {
  display: grid;
  grid-auto-flow: column;
  justify-content: center;
  align-items: center;
  gap: 16px;
}

.mpin-input-box-icon {
  height: 20px;
  width: 20px;
}

.mpin-input-box-icon:first-child {
  margin-left: 0px;
}

.mpin-keyboard-container {
  display: grid;
  align-items: center;
  justify-content: center;
  -webkit-align-items: center;
  grid-auto-flow: column;
  gap: 32px
}

.mpin-input-keyboard-group-button {
  width: 72px;
  height: 72px;
  border-radius: 96px;
  background-color: var(--snow-white);
  display: grid;
  align-items: center;
  -webkit-align-items: center;
  place-items: center;

  color: var(--black);
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 2 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 24px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.mpin-input-keyboard-group-forgot-button {
  width: 72px;
  height: 72px;
  color: var(--orange-300);
  display: grid;
  align-items: center;
  -webkit-align-items: center;
  place-items: center;
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 5 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.mpin-inut-prompt-box {
  display: flex;
  display: -webkit-flex;
  flex-direction: row;
  -webkit-flex-direction: row;
  justify-content: center;
  -webkit-justify-content: center;
  height: 20px;
  width: 100%;
}

.mpin-inut-prompt-box-text {
  width: 322px;
}

.mpin-input-keyboard-group {
  display: grid;
  grid-auto-flow: row;
  align-items: center;
  -webkit-align-items: center;
  padding: 32px 32px 72px 32px;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

.mpin-lodaing {
  width: 96px;
  height: 96px;
}

.am-mask {
  background-color: rgba(0, 0, 0, 0.55);
}

.am-mask__m {
  background-color: rgba(0, 0, 0, 0.75);
}

.am-mask__fix {
  width: 300vw;
  height: 300vh;
  transform: translate3d(-100vw, -100vh, 0);
}

.delete-icon {
  height: 32px;
  width: 32px;
}

.ant-popup-content {
  display: grid;
  flex-direction: column;
}

.ant-popup-transform-bottom {
  display: flex;
  bottom: 48px;
  right: 24px;
  left: 24px;
  padding: 24px 16px;
  border-radius: 16px;
  background: var(--functional-bw-tones-white, #FFF);
  box-shadow: 0 10px 32px 0 rgba(78, 78, 78, 0.27);
}

.button-hover-class {
  background-color: #C2F0EC !important;
}

@media (max-height: 800px) {
  .pin-title-container {
    display: grid;
    height: 120px;
    grid-template-rows: auto auto auto;
    align-items: start;
    gap: 24px;
  }

  .mpin-input-box-container {
    display: grid;
    padding: 24px 0px;
    grid-auto-flow: row;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }

  .mpin-input-keyboard-group {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-auto-flow: row;
    align-items: center;
    -webkit-align-items: center;
    padding: 32px 32px 72px 32px;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  
.mpin-input-keyboard-group-button {
  width: 60px;
  height: 60px;
  border-radius: 96px;
  background-color: var(--snow-white);
  display: grid;
  align-items: center;
  -webkit-align-items: center;
  place-items: center;

  color: var(--black);
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 2 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 24px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

.mpin-input-keyboard-group-forgot-button {
  width: 60px;
  height: 60px;
  color: var(--orange-300);
  display: grid;
  align-items: center;
  -webkit-align-items: center;
  place-items: center;
  text-align: center;
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 5 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 14px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
}

}