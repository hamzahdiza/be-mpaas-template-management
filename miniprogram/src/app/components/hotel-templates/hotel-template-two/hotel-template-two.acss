.container-index.hotel-boutique {
  background-color: #f8f5f2;
  min-height: 100vh;
  font-family: 'Times New Roman', Times, serif;
}

.boutique-header {
  padding: 96px 40px 64px;
}

.header-accent-line {
  width: 64px;
  height: 1px;
  background-color: #0f172a;
  margin-bottom: 48px;
}

.boutique-tagline {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  font-family: -apple-system, sans-serif;
  margin-bottom: 32px;
  display: block;
}

.boutique-name {
  font-size: 48px;
  font-style: italic;
  letter-spacing: -0.05em;
  color: #0f172a;
  line-height: 0.8;
  margin-bottom: 32px;
  display: block;
}

.boutique-location {
  display: flex;
  align-items: center;
  gap: 12px;
}

.dot-boutique {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #2563eb;
}

.location-text-boutique {
  font-size: 10px;
  font-weight: 900;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-family: -apple-system, sans-serif;
}

.boutique-list {
  padding: 0 32px;
}

.boutique-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 128px;
}

.boutique-card.reverse {
  align-items: flex-end;
  text-align: right;
}

.boutique-img-container {
  position: relative;
  width: 90%;
  aspect-ratio: 3/4;
  margin-bottom: 40px;
  box-shadow: 0 40px 80px -15px rgba(0, 0, 0, 0.2);
}

.boutique-img {
  width: 100%;
  height: 100%;
}

.boutique-price-tag {
  position: absolute;
  bottom: 32px;
  background-color: white;
  padding: 16px 32px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
  transform: rotate(-4deg);
}

.boutique-card.reverse .boutique-price-tag {
  left: -10%;
}

.boutique-card:not(.reverse) .boutique-price-tag {
  right: -10%;
}

.price-text-boutique {
  font-size: 12px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: 0.1em;
  font-family: -apple-system, sans-serif;
}

.boutique-info {
  max-width: 80%;
}

.boutique-room-name {
  font-size: 32px;
  font-style: italic;
  color: #0f172a;
  line-height: 1;
  margin-bottom: 16px;
  display: block;
}

.boutique-explore-btn {
  font-size: 10px;
  font-weight: 900;
  color: #2563eb;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-family: -apple-system, sans-serif;
}
