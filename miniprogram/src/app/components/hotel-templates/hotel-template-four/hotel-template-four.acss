.container-index.hotel-urban {
  background-color: white;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.urban-header {
  padding: 80px 40px 48px;
}

.urban-header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 80px;
}

.urban-title-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.urban-tagline {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.4em;
}

.urban-hotel-name {
  font-size: 48px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  line-height: 0.75;
  text-transform: uppercase;
  display: block;
}

.urban-stay-badge {
  width: 64px;
  height: 64px;
  background-color: #2563eb;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 25px 50px -12px rgba(37, 99, 235, 0.4);
}

.urban-stay-text {
  font-size: 10px;
  font-weight: 900;
  color: white;
  letter-spacing: 0.2em;
  transform: rotate(-90deg);
}

.urban-list {
  display: flex;
  flex-direction: column;
  gap: 80px;
}

.urban-room-card {
  display: flex;
  flex-direction: column;
}

.urban-img-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16/11;
  margin-bottom: 32px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.urban-room-img {
  width: 100%;
  height: 100%;
}

.urban-number-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #2563eb;
  padding: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.urban-number {
  font-size: 24px;
  font-weight: 900;
  color: white;
  font-style: italic;
  letter-spacing: -0.05em;
}

.urban-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 8px 32px;
  border-bottom: 4px solid #0f172a;
}

.urban-info-left {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.urban-room-name {
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  text-transform: uppercase;
  font-style: italic;
}

.urban-room-meta {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.3em;
}

.urban-info-right {
  text-align: right;
}

.urban-price-val {
  font-size: 20px;
  font-weight: 900;
  color: #2563eb;
  font-style: italic;
  letter-spacing: -0.05em;
  display: block;
}

.urban-price-unit {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
}
