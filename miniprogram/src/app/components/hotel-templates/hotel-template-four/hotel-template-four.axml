<view class="container-index hotel-urban">
  <view class="urban-header">
    <view class="urban-header-top">
      <view class="urban-title-col">
        <text class="urban-tagline">Next-Gen Stay</text>
        <text class="urban-hotel-name">{{data.name}}</text>
      </view>
      <view class="urban-stay-badge">
        <text class="urban-stay-text">STAY</text>
      </view>
    </view>
    
    <view class="urban-list">
      <block a:for="{{data.categories}}" a:for-index="idx">
        <view class="urban-room-card" onTap="handleRoomTap" data-item="{{item}}">
          <view class="urban-img-wrapper">
            <image class="urban-room-img" src="{{item.images[0]}}" mode="aspectFill" />
            <view class="urban-number-badge">
              <text class="urban-number">0{{idx + 1}}</text>
            </view>
          </view>
          <view class="urban-info-row">
            <view class="urban-info-left">
              <text class="urban-room-name">{{item.name}}</text>
              <text class="urban-room-meta">{{item.roomType}} 👤 {{item.capacity}} Guests</text>
            </view>
            <view class="urban-info-right">
              <text class="urban-price-val">Rp {{item.pricePerNight.toLocaleString('id-ID')}}</text>
              <text class="urban-price-unit">per night</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
