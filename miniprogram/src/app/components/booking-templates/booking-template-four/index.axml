<view class="t4-book-container">
    <view class="t4-sticky-header">
        <top-bar
            type="navigation"
            navigate="{{true}}"
            exit="{{isExit}}"
            backgroundColor="bg-white"
            title="Select Tickets"
            iconL="/src/assets/icons/ic_common_arrow_back.svg"
            safeArea="{{true}}"
            pixel
        />
        <!-- Toast/Snackbar -->
        <view a:if="{{ isCopyTriggered }}" onTap="disableToast" class="{{isToastIn?'toast-container-in' : 'toast-container-out'}} toast-position">
            <snackbar
                pixel
                class="snackbar-container"
                isSnackbarVisible="true"
                iconCustom="/src/assets/icons/ic_common_warning_filled.svg"
                txt="{{lang.javaJazzFestivalListTicketScreenToastMaxTicketLabel}}"
            />
        </view>
    </view>

    <loading pixel loading="{{ isLoading }}" />

    <view a:if="{{ !isLoading }}" class="t4-book-content">
        <!-- Header Info -->
        <view class="t4-book-info">
            <text class="t4-book-title">{{ticketData.title}}</text>
            <text class="t4-book-desc">{{ticketData.description}}</text>
        </view>

        <!-- Tabs -->
        <view a:if="{{ showTab }}" class="tab-segmented">
            <block a:for="{{ tabFilter }}">
                <view onTap="handleFilter" data-idx="{{index}}" class="tab-pill {{tabActive === index ? 'active' : 'inactive'}}">
                    <text class="tab-text">{{item.title}}</text>
                </view>
            </block>
        </view>

        <!-- Ticket List -->
        <view class="t4-ticket-list">
             <view
                a:for="{{ tabActive === 0 ? dataPromoList : dataRegulerList }}"
                a:for-index="idx"
                class="t4-ticket-card {{item.isAvailable==0 ? 't4-disabled' : ''}}"
            >
                <view class="t4-card-content">
                    <view class="t4-card-header-row">
                        <view>
                            <text class="t4-card-title">{{item.ticketName}}</text>
                            <text class="t4-card-cat">{{item.category}}</text>
                        </view>
                        <view class="t4-tag" a:if="{{item.type == 'b1g1'}}">
                            <text>B1G1</text>
                        </view>
                    </view>

                    <view class="t4-price-row">
                         <view class="t4-price-group">
                             <text a:if="{{ item.oldPrice > item.price }}" class="t4-price-original">{{item.oldPriceFormat}}</text>
                             <text class="t4-price-final">{{item.formatPriceTaxService}}</text>
                         </view>
                         
                         <!-- Counter -->
                        <view class="t4-counter" a:if="{{item.isAvailable==1}}">
                            <view class="t4-btn-minus {{item.count == 0 ? 't4-btn-disabled' : ''}}" onTap="handleRemove" 
                                data-index="{{idx}}" 
                                data-item="{{item}}"
                                data-count="{{item.count}}"
                                data-amount="{{item.price}}"
                                data-title="{{item.ticketName}}"
                                data-type="{{item.type}}"
                                data-ticket-id="{{item.ticketId}}"
                                data-count-add="{{1}}">
                                <text>-</text>
                            </view>
                            <text class="t4-qty">{{item.count}}</text>
                            <view class="t4-btn-plus" onTap="handlePlus" 
                                data-index="{{idx}}" 
                                data-item="{{item}}"
                                data-count="{{item.count}}"
                                data-amount="{{item.price}}"
                                data-title="{{item.ticketName}}"
                                data-type="{{item.type}}"
                                data-ticket-id="{{item.ticketId}}"
                                data-count-add="{{1}}">
                                <text>+</text>
                            </view>
                        </view>
                         <view a:else class="t4-sold-out">
                             <text>Sold Out</text>
                         </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    
    <!-- Bottom Bar -->
    <view class="t4-bottom-bar" a:if="{{!isLoading}}">
        <view class="t4-total-info">
             <text class="t4-total-label">TOTAL</text>
             <text class="t4-total-price">{{totalPrice}}</text>
        </view>
        <view class="t4-checkout-btn-wrapper">
             <button
                class="t4-checkout-btn"
                disabled="{{totalTicket === 0}}"
                onTap="nextPage"
             >
                {{lang.javaJazzFestivalListTicketScreenNextButtonLabel}}
             </button>
        </view>
    </view>
</view>
