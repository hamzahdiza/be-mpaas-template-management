.history-container {
  padding: 0 24rpx 24rpx 24rpx;
  background-color: #f8fafc;
  min-height: 100vh;
}

.sticky-top {
  position: sticky;
  top: 0;
  z-index: 100;
}

.header {
  margin-bottom: 40rpx;
  padding: 20rpx 8rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -1rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid #f1f5f9;
}

.item-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.category-icon.event { background-color: #fff7ed; }
.category-icon.hotel { background-color: #eff6ff; }
.category-icon.cafe, .category-icon.restaurant { background-color: #ecfdf5; }

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.service-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.order-date {
  font-size: 22rpx;
  color: #94a3b8;
}

.status-badge {
  display: inline-flex;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 800;
  text-transform: uppercase;
  margin-top: 8rpx;
  width: fit-content;
}

.status-badge.accepted { background: #eff6ff; color: #2563eb; }
.status-badge.completed { background: #f0fdf4; color: #16a34a; }
.status-badge.preparing { background: #fffbeb; color: #d97706; }
.status-badge.pending { background: #f8fafc; color: #64748b; }

.item-amount {
  text-align: right;
}

.amount {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.invoice-no {
  font-size: 18rpx;
  color: #cbd5e1;
  font-weight: 600;
}

.operational-note {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e2e8f0;
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
  font-style: italic;
}

.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  color: #94a3b8;
  font-weight: 600;
}
