.container-detail-playful {
  background-color: white;
  min-height: 100vh;
  padding: 32px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.detail-header-playful {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48px;
  padding-top: 16px;
}

.back-btn-playful {
  padding: 20px;
  background-color: #fff4e0;
  border-radius: 32px;
  box-shadow: 0 10px 15px -3px rgba(244, 63, 94, 0.05);
}

.heart-btn-playful {
  padding: 20px;
  background-color: #f43f5e;
  border-radius: 32px;
  box-shadow: 0 20px 25px -5px rgba(244, 63, 94, 0.3);
}

.heart-icon {
  width: 24px;
  height: 24px;
}

.playful-detail-body {
  display: flex;
  flex-direction: column;
}

.item-img-container-playful {
  position: relative;
  margin-bottom: 56px;
}

.img-bg-accent-1 {
  position: absolute;
  inset: 0;
  background-color: #fbbf24;
  border-radius: 80px;
  transform: rotate(12deg) scale(0.95);
  opacity: 0.2;
}

.img-bg-accent-2 {
  position: absolute;
  inset: 0;
  background-color: #f43f5e;
  border-radius: 80px;
  transform: rotate(-6deg) scale(0.95);
  opacity: 0.1;
}

.item-img-playful {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 80px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}

.playful-info-section {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.item-name-playful-detail {
  font-size: 40px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  line-height: 0.8;
  text-transform: uppercase;
  display: block;
}

.price-rating-row {
  display: flex;
  align-items: center;
  gap: 16px;
}

.price-badge-playful {
  background-color: #f43f5e;
  padding: 12px 24px;
  border-radius: 24px;
  box-shadow: 0 20px 25px -5px rgba(244, 63, 94, 0.2);
}

.price-val-playful {
  color: white;
  font-size: 24px;
  font-weight: 900;
  letter-spacing: -0.05em;
  font-style: italic;
}

.rating-badge-playful {
  background-color: #fff1f2;
  padding: 12px 16px;
  border-radius: 24px;
}

.rating-val-playful {
  color: #f43f5e;
  font-size: 18px;
  font-weight: 900;
}

.item-desc-playful {
  font-size: 18px;
  font-weight: 700;
  color: #64748b;
  line-height: 1.6;
  font-style: italic;
  margin-bottom: 48px;
  display: block;
}

.footer-btn-playful {
  width: 100%;
  padding: 24px;
  background-color: #f43f5e;
  color: white;
  border-radius: 48px;
  text-align: center;
  font-size: 20px;
  font-weight: 900;
  box-shadow: 0 25px 50px -12px rgba(244, 63, 94, 0.4);
  text-transform: uppercase;
  letter-spacing: -0.025em;
}
