<view class="container-detail">
  <view class="hero-section">
    <image class="hero-img" src="{{room.imageUrl || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c'}}" mode="aspectFill" />
    <view class="hero-overlay" />
    <view class="back-btn-float" onTap="onBack">
      <icon type="left" size="18" color="#0f172a" />
    </view>
  </view>

  <view class="detail-card-container">
    <view class="detail-card">
      <view class="detail-header">
        <text class="item-name">{{room.name || 'Menu Name'}}</text>
        <view class="rating-badge">
          <text class="star-icon">★</text>
          <text class="rating-text">4.9</text>
        </view>
      </view>

      <text class="item-desc">{{room.description || 'No description available for this item.'}}</text>

      <view class="price-stepper-row">
        <view class="price-col">
          <text class="price-label">Price</text>
          <text class="price-val">Rp {{room.price.toLocaleString('id-ID')}}</text>
        </view>
        <view class="stepper-container">
          <view class="stepper-btn minus">-</view>
          <text class="stepper-val">1</text>
          <view class="stepper-btn plus">+</view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="footer-action">
    <view class="add-to-cart-btn" onTap="onBook">
      Tambah ke Keranjang
    </view>
  </view>
</view>
