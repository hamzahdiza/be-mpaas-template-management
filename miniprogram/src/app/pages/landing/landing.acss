/* LIFESTYLE */

.base-background-0 {
  background-color: #9B7EDC;
  width: 100%;
  height: 260px;
  position: absolute;
  z-index: 0;
  top: 0;
}

.base-background {
  background-color: #9B7EDC;
  width: 100%;
  height: 60px;
  position: absolute;
  z-index: 0;
  top: 0;
}

.modal-scroll {
  /* height: 100vh; */
  overflow: scroll;
  position: sticky;
  /* margin-top: 200px; */
}

.sticky-top {
  position: sticky;
  top: 0;
  z-index: 100;
  left: 0;
  /* background-color: #9B7EDC; */
}

.scroll-container {
  display: flex;
  width: calc(100%);
  /* height: 100%; */
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  position: relative;
  background-color: #ffffff;
  /* overflow-y: auto; */
}

.background-content-base {
  background-color: #9B7EDC;
  position: absolute;
  width: 100%;
  height: 250px;
  z-index: 0;
}

.main-hero-header {
  width: 100%;
  height: 123px;
  background-color: #9B7EDC;
  position: relative;
  z-index: 1;
  /* margin-top: 150px; */
}

.landing-image {
  width: 100%;
  height: 100%;
  position: absolute;
  bottom: 0;
  left: 0;
}

.landing-image-left {
  width: 68px;
  height: 98px;
  position: absolute;
  bottom: 0;
  left: 0;
}

.landing-image-right {
  width: 116px;
  height: 108px;
  position: absolute;
  bottom: 0;
  right: 0;
}

.header-head-image-circle-light-container {
  width: 396px;
  height: 396px;
  flex-shrink: 0;
  position: absolute;
}

.header-head-image-circle-light {
  width: 150px;
  height: 150px;
  fill: var(--Brand-BNI-Purple-Purple-200, #BBA7E7);
}

.hero-header {
  display: flex;
  width: calc(100%);
  min-height: 119px;
  height: fit-content;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  padding-top: 4px;
}

.color-base-hero-header {
  width: 100%;
  height: 392%;
  background-color: white;
}

.header-content {
  display: grid;
  grid-template-columns: 1fr;
  width: calc(100% - 48px);
  height: 119px;
  z-index: 6;
  padding: 0px 24px;
}

.header-content-left {
  display: flex;
  width: 223px;
  height: 100px;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  flex-shrink: 0;
}

.header-content-title-loading {
  width: 100%;
  min-height: 20px;
}

.header-content-description-loading {
  margin-top: 8px;
  width: 100%;
  min-height: 20px;
}

.header-content-title {
  align-self: stretch;
  color: var(--functional-bw-tones-white, #FFF);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 3 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 18px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 21.6px */
}

.header-content-description {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  align-self: stretch;
  overflow: hidden;
  color: var(--functional-bw-tones-white, #FFF);
  font-feature-settings: 'liga'off, 'clig'off;
  text-overflow: ellipsis;

  /* Mobile/Body/Body 3 - Regular */
  font-family: "TT Interphases Pro";
  font-size: 12px;
  font-style: normal;
  font-weight: 400;
  line-height: 140%;
  /* 16.8px */

  margin-top: 8px;
}

.header-head-image-container {
  height: 100%;
  align-content: flex-end;
  justify-content: flex-end;
}

/* =========== */

.main-container-content {
  display: flex;
  width: 100%;
  min-height: fit-content;
  height: fit-content;
  flex-direction: column;
  align-items: center;
  position: relative;
  bottom: 19px;
  z-index: 4;
  /* margin-top: -19px; */
}

.content-categories {
  width: 100%;
  display: flex;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* max-width: 327px; */
}

.section-header-title {
  color: var(--functional-bw-tones-white, #FFF);
  font-feature-settings: 'liga'off, 'clig'off;

  /* Mobile/Headline/Headline 4 - Bold */
  font-family: "TT Interphases Pro";
  font-size: 16px;
  font-style: normal;
  font-weight: 700;
  line-height: 120%;
  /* 19.2px */
}

