.container-detail {
  background-color: white;
  min-height: 100vh;
  padding-bottom: 120px;
}

.hero-section {
  position: relative;
  height: 384px;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.4), transparent, transparent);
}

.back-btn-float {
  position: absolute;
  top: 48px;
  left: 24px;
  background-color: rgba(255, 255, 255, 0.9);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.detail-card-container {
  padding: 0 24px;
  margin-top: -40px;
  position: relative;
  z-index: 10;
}

.detail-card {
  background-color: white;
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
  border: 1px solid #f1f5f9;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.item-name {
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  line-height: 1.2;
  flex: 1;
  padding-right: 16px;
}

.rating-badge {
  display: flex;
  align-items: center;
  gap: 4px;
  background-color: #ecfdf5;
  padding: 4px 8px;
  border-radius: 8px;
}

.star-icon {
  color: #10b981;
  font-size: 12px;
}

.rating-text {
  font-size: 12px;
  font-weight: 700;
  color: #047857;
}

.item-desc {
  font-size: 14px;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 24px;
  display: block;
}

.price-stepper-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24px;
  border-top: 1px solid #f1f5f9;
}

.price-col {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 4px;
}

.price-val {
  font-size: 20px;
  font-weight: 900;
  color: #059669;
}

.stepper-container {
  display: flex;
  align-items: center;
  gap: 16px;
  background-color: #f1f5f9;
  padding: 8px;
  border-radius: 16px;
}

.stepper-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: white;
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  font-weight: 900;
  color: #94a3b8;
}

.stepper-btn.plus {
  background-color: #059669;
  color: white;
}

.stepper-val {
  font-weight: 900;
  color: #0f172a;
  font-size: 14px;
}

.footer-action {
  position: fixed;
  bottom: 48px;
  left: 24px;
  right: 24px;
  z-index: 30;
}

.add-to-cart-btn {
  background-color: #059669;
  color: white;
  padding: 18px;
  border-radius: 16px;
  text-align: center;
  font-size: 16px;
  font-weight: 900;
  box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
}
