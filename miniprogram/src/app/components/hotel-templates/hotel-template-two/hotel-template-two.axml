<view class="container-index hotel-boutique">
  <view class="boutique-header">
    <view class="header-accent-line" />
    <text class="boutique-tagline">The Art of Stay</text>
    <text class="boutique-name">{{data.name}}</text>
    <view class="boutique-location">
      <view class="dot-boutique" />
      <text class="location-text-boutique">{{data.locationAddress}}</text>
    </view>
  </view>

  <view class="boutique-list">
    <block a:for="{{data.categories}}" a:for-index="idx">
      <view class="boutique-card {{idx % 2 === 1 ? 'reverse' : ''}}" onTap="handleRoomTap" data-item="{{item}}">
        <view class="boutique-img-container">
          <image class="boutique-img" src="{{item.images[0]}}" mode="aspectFill" />
          <view class="boutique-price-tag">
            <text class="price-text-boutique">Rp {{item.pricePerNight.toLocaleString('id-ID')}}</text>
          </view>
        </view>
        <view class="boutique-info">
          <text class="boutique-room-name">{{item.name}}</text>
          <text class="boutique-explore-btn">Explore Collection →</text>
        </view>
      </view>
    </block>
  </view>
</view>
