.t4-book-container {
    min-height: 100vh;
    background-color: #FFFFFF;
    padding-bottom: 100px;
}

.t4-sticky-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #FFFFFF;
}

.t4-book-content {
    padding: 24px;
}

.t4-book-info {
    margin-bottom: 32px;
}

.t4-book-title {
    font-size: 24px;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 8px;
    display: block;
    line-height: 1.2;
    letter-spacing: -0.5px;
}

.t4-book-desc {
    font-size: 15px;
    color: #636366;
    margin-bottom: 16px;
    display: block;
    line-height: 1.5;
}

.t4-book-meta {
    display: flex;
    align-items: center;
    gap: 8px;
}

.t4-icon-sm {
    width: 16px;
    height: 16px;
}

.t4-meta-text {
    font-size: 14px;
    font-weight: 500;
    color: #1A1A1A;
}

/* Premium Segmented Tab Style */
.tab-segmented {
  display: flex;
  background-color: #F2F2F7;
  border-radius: 12px;
  padding: 4px;
  margin-top: 24px;
  margin-bottom: 24px;
}

.tab-pill {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  border-radius: 9px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-pill.active {
  background-color: #FFFFFF;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  color: #1A1A1A;
  font-weight: 700;
}

.tab-pill.inactive {
  color: #8E8E93;
  font-weight: 500;
}

.tab-text {
  font-size: 14px;
}

.t4-ticket-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.t4-ticket-card {
    background: #F5F5F7;
    /* border-left: 4px solid transparent; */
    padding: 20px;
    /* transition: border-color 0.3s; */
}

/* Hover effect not directly supported in axml same as web, but we can style active state or leave as static */

.t4-disabled {
    opacity: 0.6;
}

.t4-card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
}

.t4-card-title {
    font-size: 18px;
    font-weight: 700;
    color: #1A1A1A;
    display: block;
    margin-bottom: 4px;
}

.t4-card-cat {
    font-size: 13px;
    color: #636366;
}

.t4-tag {
    background: #E5E5E5;
    color: #1A1A1A;
    font-size: 11px;
    font-weight: 500;
    padding: 4px 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.t4-price-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 16px;
    border-top: 1px solid #E5E5E5;
}

.t4-price-group {
    display: flex;
    flex-direction: column;
}

.t4-price-final {
    font-size: 20px;
    font-weight: 700;
    color: #1A1A1A;
}

.t4-price-original {
    font-size: 13px;
    color: #8E8E93;
    text-decoration: line-through;
    margin-bottom: 4px;
}

.t4-counter {
    display: flex;
    align-items: center;
    gap: 16px;
}

.t4-btn-minus, .t4-btn-plus {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #D1D1D6;
    background: #FFFFFF;
    font-size: 18px;
    font-weight: 500;
    color: #1A1A1A;
}

.t4-btn-plus {
    background: #1A1A1A;
    border-color: #1A1A1A;
    color: #FFFFFF;
}

.t4-btn-disabled {
    opacity: 0.5;
    background: #F2F2F7;
}

.t4-qty {
    font-size: 16px;
    font-weight: 500;
    min-width: 24px;
    text-align: center;
}

.t4-sold-out {
    background: #E5E5E5;
    padding: 6px 12px;
    font-size: 12px;
    color: #636366;
    font-weight: 500;
}

.t4-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid #E5E5E5;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 90;
    gap: 24px;
}

.t4-total-info {
    display: flex;
    flex-direction: column;
}

.t4-total-label {
    font-size: 11px;
    color: #8E8E93;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
}

.t4-total-price {
    font-size: 20px;
    font-weight: 700;
    color: #1A1A1A;
}

.t4-checkout-btn-wrapper {
    flex: 1;
}

.t4-checkout-btn {
    width: 100%;
    height: 50px;
    background: #007AFF;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 0; /* Square button per design */
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.t4-checkout-btn[disabled] {
    background: #E5E5E5;
    color: #8E8E93;
}

/* Toast utils */
.toast-position {
  position: absolute;
  top: 16px;
  left: 16px;
  right: 16px;
  z-index: 999;
}

.toast-container-in {
  opacity: 1;
  transition: opacity 0.3s ease-in;
}

.toast-container-out {
  opacity: 0;
  transition: opacity 0.3s ease-out;
}
