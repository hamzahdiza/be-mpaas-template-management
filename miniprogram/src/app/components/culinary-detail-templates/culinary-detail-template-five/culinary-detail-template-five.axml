<view class="container-detail-modern">
  <view class="detail-header-modern">
    <view class="back-btn-modern" onTap="onBack">
      <icon type="left" size="24" color="#0f172a" />
    </view>
    <text class="essence-label-modern">Product Essence</text>
    <view class="heart-btn-modern">
      <icon type="heart" size="24" color="#f43f5e" />
    </view>
  </view>

  <view class="modern-detail-body">
    <view class="item-hero-modern">
      <view class="hero-bg-accent" />
      <image class="hero-img-modern" src="{{room.imageUrl}}" mode="aspectFill" />
      <text class="item-name-modern-detail">{{room.name}}</text>
      <text class="item-price-modern-detail">Rp {{room.price.toLocaleString('id-ID')}}</text>
    </view>

    <view class="modern-info-grid">
      <view class="info-stat-modern">
        <text class="stat-label-modern">Calories</text>
        <text class="stat-val-modern">450 kcal</text>
      </view>
      <view class="info-stat-modern">
        <text class="stat-label-modern">Prep Time</text>
        <text class="stat-val-modern">15 mins</text>
      </view>
    </view>

    <view class="story-section-modern">
      <text class="story-label-modern">Product Story</text>
      <text class="story-text-modern">{{room.description}}</text>
    </view>

    <view class="footer-action-modern">
      <view class="add-basket-btn-modern" onTap="onBook">
        ADD TO BASKET →
      </view>
    </view>
  </view>
</view>
