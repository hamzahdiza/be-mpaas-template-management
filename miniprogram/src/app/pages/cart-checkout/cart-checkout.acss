.sticky-top {
  position: sticky;
  top: 0;
  z-index: 100;
}

.scroll-container {
  background-color: #F7F6FB;
  height: calc(100vh - 150px);
}

.cart-section {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.shadow-sm {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.merchant-card {
  background: white;
  border-radius: 24px;
  padding: 24px;
  border: 1px solid #eee;
}

.merchant-type {
  font-size: 10px;
  font-weight: 900;
  color: #9B7EDC;
  letter-spacing: 2px;
  margin-bottom: 4px;
  display: block;
}

.merchant-name {
  font-size: 20px;
  font-weight: 800;
  color: #1a1a1a;
}

.info-section {
  background: white;
  border-radius: 24px;
  padding: 24px;
  border: 1px solid #eee;
}

.section-title {
  font-size: 14px;
  font-weight: 900;
  color: #1a1a1a;
  margin-bottom: 20px;
  display: block;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.info-label {
  font-size: 12px;
  color: #888;
}

.info-val {
  font-size: 13px;
  font-weight: 700;
  color: #1a1a1a;
}

.divider {
  height: 1px;
  background: #f1f1f1;
  margin: 16px 0;
}

.total-row {
  margin-bottom: 0;
}

.total-label {
  font-size: 14px;
  font-weight: 800;
  color: #1a1a1a;
}

.total-val {
  font-size: 18px;
  font-weight: 950;
  color: #e53935;
}

.cart-item-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cart-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-item-info {
  display: flex;
  flex-direction: column;
}

.cart-item-name {
  font-size: 14px;
  font-weight: 700;
  color: #1a1a1a;
}

.cart-item-price {
  font-size: 12px;
  color: #888;
}

.cart-item-qty {
  font-size: 14px;
  font-weight: 700;
  color: #1a1a1a;
  min-width: 24px;
  text-align: center;
}

.qty-controls {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-qty {
  width: 24px;
  height: 24px;
  border-radius: 8px;
  border: 1px solid #9B7EDC;
  color: #9B7EDC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 900;
}

.btn-qty.minus {
  background: white;
}

.btn-qty.plus {
  background: #9B7EDC;
  color: white;
}

.btn-remove {
  margin-left: 8px;
  padding: 4px;
}

.icon-remove {
  width: 16px;
  height: 16px;
  opacity: 0.4;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20px 24px 40px;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
}

.pay-btn {
  background: #9B7EDC;
  color: white;
  height: 56px;
  border-radius: 20px;
  font-size: 15px;
  font-weight: 900;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
