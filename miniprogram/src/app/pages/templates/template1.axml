<template name="template1">
  <view id="lifestyle-java-jazz-festival-landing-page-screen-banner" class="event-poster">
    <swiper
      current="{{ currentPoster }}"
      autoplay="{{ true }}"
      duration="1000"
      circular="{{ true }}"
      onChange="onSwipeChangePoster"
    >
      <block
        a:for="{{ detailEvent.banner.slice(0, 5) }}"
        a:for-index="index"
        a:for-item="item"
        a:key="{{ index }}"
      >
        <swiper-item>
          <view class="swiper-item">
            <view class="poster-image" style="background: url('{{ item }}') lightgray 50% / cover no-repeat;" />
          </view>
        </swiper-item>
      </block>
    </swiper>

    <view class="indicator-dots" a:if="{{ detailEvent.banner.length > 1 }}">
      <view a:for="{{ detailEvent.banner.slice(0, 5) }}" a:for-index="index">
        <view onTap="indicatorPoster" data-index="{{index}}" style="{{index == currentPoster ? 'background-color:var(--black);': 'background-color:var(--light-gray);'}}" />
      </view>
    </view>
  </view>
  <view class="event-container">

    <view class="event-title">
      <text
        id="lifestyle-java-jazz-festival-landing-page-screen-event-name"
        class="txt-h2"
      >
        {{detailEvent.eventName}}
      </text>
      <view class="event-date-location">
        <view class="event-date">
          <image class="icon-size-48" src="/src/assets/icons/ic_common_calendar_today.svg" />
          <text
            id="lifestyle-java-jazz-festival-landing-page-screen-event-date"
            class="txt-body2-px txt-black"
          >
            {{detailEvent.eventDate}}
          </text>
        </view>
        <view class="event-location" onTap="openMap">
          <image class="icon-size-48" src="/src/assets/icons/ic_common_location_on.svg" />
          <view class="event-location-detail">
            <text
              id="lifestyle-java-jazz-festival-landing-page-screen-event-location"
              class="txt-body2-sb-px"
            >
              {{detailEvent.location}}
            </text>
            <text
              id="lifestyle-java-jazz-festival-landing-page-screen-location-address"
              class="txt-body3-px"
            >
              {{detailEvent.locationAddress}}
            </text>
          </view>
          <image class="icon-size-48" src="/src/assets/icons/ic_common_chevron_right.svg" />
        </view>
      </view>
      <view a:if="{{ isExpanded }}" class="event-detail-container">
        <view class="d-flex-col">
          <image
            class="icon-size-48"
            src="/src/assets/icons/ic_common_instagram.svg"
            style="visibility:hidden;"
          />
          <text
            id="lifestyle-java-jazz-festival-landing-page-screen-description"
            class="txt-body2-px txt-granite"
          >
            {{detailEvent.description}}
          </text>
        </view>
        <view a:if="{{ detailEvent.instagram }}" class="d-flex-col">
          <image class="icon-size-48" src="/src/assets/icons/ic_common_instagram.svg" />
          <text
            id="lifestyle-java-jazz-festival-landing-page-screen-instagram"
            class="txt-body2-px txt-black"
          >
            {{detailEvent.instagram}}
          </text>
        </view>
        <view a:if="{{ detailEvent.website }}" class="d-flex-col">
          <image class="icon-size-48" src="/src/assets/icons/ic_common_browser.svg" />
          <text
            id="lifestyle-java-jazz-festival-landing-page-screen-website"
            class="txt-body2-px txt-black"
          >
            {{detailEvent.website}}
          </text>
        </view>
      </view>
      <view class="event-detail-button" onTap="isExpanded">
        <text
          id="{{isExpanded ?  'lifestyle-java-jazz-festival-landing-page-screen-click-tutup' : 'lifestyle-java-jazz-festival-landing-page-screen-click-deskripsi'}}"
          class="txt-description"
        >
          {{isExpanded ?  lang.lifestyleJavaJazzFestivalLandingScreenCloseEventDescLabel : lang.lifestyleJavaJazzFestivalLandingScreenOpenEventDescLabel}}
        </text>
        <image class="icon-size-32" mode="scaleToFill" src="/src/assets/icons/ic_common_chevron_{{isExpanded ?  'up' : 'down'}}_orange.svg" />
      </view>
    </view>
    <view class="event-ticket">
      <text class="txt-h4">
        {{lang.lifestyleJavaJazzFestivalLandingScreenChooseTicketLabel}}
      </text>
      <view a:for="{{ ticketDataList }}" a:for-item="item" class="ticket-card-list">
        <view
          id="lifestyle-java-jazz-festival-landing-page-screen-select-ticket"
          onTap="goToTicketList"
          data-ticketData={{item}}
          class="{{ item.isPromo ? 'ticket-card-item-promo' : 'ticket-card-item' }} ticket-bg-normal"
        >
          <view class="product-card-container">
            <view class="product-card">
              <view a:if="{{ item.isPromo }}" class="txt-label3-sb tag-normal">
                {{lang.lifestyleJavaJazzFestivalLandingScreenPromoLabel}}
              </view>
              <view class="product-card-header">
                <view
                  id="lifestyle-java-jazz-festival-landing-page-screen-title-ticket"
                  class="product-title txt-black"
                >
                  {{item.title}}
                </view>
                <text
                  id="lifestyle-java-jazz-festival-landing-page-screen-description-ticket"
                  class="ticket-description txt-charcoal"
                >
                  {{item.description}}
                </text>
              </view>
            </view>
            <view class="product-illustration-round"></view>
          </view>
          <view class="divider" />
          <view class="price-information">
            <view class="price-style">
              <text class="txt-label3 {{ item.status === 'soldout' ? 'txt-granite': 'txt-charcoal'}} ">
                {{lang.lifestyleJavaJazzFestivalLandingScreenAmountStartFromLabel}}
              </text>
              <view class="price-total">
                <text
                  id="lifestyle-java-jazz-festival-landing-page-screen-start-from-ticket"
                  class="txt-body1-sb-px txt-black"
                >
                  {{item.price}}
                </text>
              </view>
            </view>
            <view>
              <image class="icon-size-48" src="/src/assets/icons/ic_common_chevron_right.svg" />
            </view>
          </view>
        </view>
      </view>
    </view>
    <view
      a:if="{{ detailEvent.infoImages.length > 0 }}"
      id="lifestyle-java-jazz-festival-landing-page-screen-image-info"
      class="event-info"
    >
      <view class="section-header" onTap="isExpandInfo">
        <text class="txt-h4">
          {{lang.lifestyleJavaJazzFestivalLandingScreenInfoSectionTitleLabel}}
        </text>
        <image class="icon-size-48" src="/src/assets/icons/ic_common_chevron_{{ isExpandInfo ? 'up' : 'down' }}.svg" />
      </view>
      <view a:if="{{ isExpandInfo }}" class="promo-card">
        <swiper
          current="{{ currentInfo }}"
          autoplay="{{ true }}"
          duration="1000"
          circular="{{ true }}"
          onChange="onSwipeChangePromo"
        >
          <block
            a:for="{{ detailEvent.infoImages.slice(0, 5) }}"
            a:for-index="index"
            a:for-item="item"
            a:key="{{ index }}"
          >
            <swiper-item>
              <view
                onTap="popupPromo"
                data-image={{item}}
                class="promo-card-image"
                style="background: url('{{item}}') lightgray 0px 0px / 100% 103.873% no-repeat;"
              >
                <view class="icon-fullscreen">
                  <image class="icon-size-48" src="/src/assets/icons/ic_fullscreen.svg" />
                </view>
              </view>
            </swiper-item>
          </block>
        </swiper>
        <view a:if="{{ detailEvent.infoImages.length > 1 }}" class="indicator-dots">
          <view a:for="{{ detailEvent.infoImages.slice(0, 5) }}" a:for-index="index">
            <view onTap="indicatorPromo" data-index="{{index}}" style="{{index == currentInfo ? 'background-color:var(--black);': 'background-color:var(--light-gray);'}}" />
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="tnc-container">
    <text class="tnc-main-text">
      {{lang.lifestyleJavaJazzFestivalLandingScreenTermsCondition1Label+" "}}
      <text
        id="lifestyle-java-jazz-festival-landing-page-screen-tnc-button"
        onTap="goToTnc"
        class="tnc-hightlight-text"
      >
        {{lang.lifestyleJavaJazzFestivalLandingScreenTermsCondition2Label}}
      </text> {{" "+lang.lifestyleJavaJazzFestivalLandingScreenTermsCondition3Label}}
    </text>
  </view>
</template>
