<view class="container-detail-urban">
  <view class="urban-detail-body">
    <view class="urban-detail-header">
      <view class="urban-back-btn-large" onTap="onBack">
        <icon type="left" size="32" color="#0f172a" />
      </view>
      <text class="urban-tech-label">Technical Overview</text>
      <view class="urban-accent-dot" />
    </view>
    
    <view class="urban-hero-room-large">
      <image class="urban-room-img-large" src="{{room.images[0]}}" mode="aspectFill" />
      <view class="urban-hero-badge">
         <text class="urban-hero-type">{{room.roomType}}</text>
      </view>
    </view>
    
    <view class="urban-info-section-large">
      <view class="urban-info-header-large">
        <text class="urban-room-name-large">{{room.name}}</text>
        <view class="urban-price-col-large">
           <text class="urban-price-val-large">Rp {{room.pricePerNight.toLocaleString('id-ID')}}</text>
           <text class="urban-price-label-large">Selected Rate</text>
        </view>
      </view>
      
      <text class="urban-room-desc-large">{{room.description}}</text>
      
      <view class="urban-footer-large" onTap="onBook">
        Confirm Stay →
      </view>
    </view>
  </view>
</view>
