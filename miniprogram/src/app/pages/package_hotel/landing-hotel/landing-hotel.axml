<view class="hotel-index-container">
  <view class="top-bar-fixed">
    <top-bar
      type="navigation"
      navigate="{{true}}"
      onIconLTap="onGoBack"
      title="Wondr Stay"
      backgroundColor="#FFFFFF"
      pixel
      safeArea
    />
  </view>

  <scroll-view scroll-y="{{true}}" class="scroll-content">
    <view a:if="{{ successFetch }}" class="list-wrapper">

      <block a:for="{{ hotelList }}" a:for-item="hotel">

        <!--<view 
          a:if="{{ hotel.templateId == 1 }}" 
          class="hotel-card-t1" 
          onTap="goToDetail" 
          data-id="{{hotel.id}}"
        ><image class="banner-t1" src="{{hotel.bannerUrl}}" mode="aspectFill" /><view class="info-t1"><text class="name-t1">{{hotel.name}}</text><view class="meta-t1"><image src="/src/assets/icons/ic_common_location.svg" class="icon-12" /><text class="loc-t1">{{hotel.location}}</text></view><view class="price-row"><text class="price-start">Mulai dari</text><text class="price-val">{{hotel.formattedPrice}}</text></view></view></view> -->

        <view class="hotel-card-t2" onTap="goToDetail" data-id="{{hotel.id}}">
          <view class="badge-luxury">Luxury</view>
          <image class="banner-t2" src="{{hotel.bannerUrl}}" mode="aspectFill" />
          <view class="overlay-t2">
            <text class="name-t2">{{hotel.name}}</text>
            <view class="stars-row">
              <image
                a:for="{{hotel.stars}}"
                src="/src/assets/icons/ic_common_star_filled.svg"
                class="icon-star"
              />
            </view>
            <text class="price-t2">{{hotel.formattedPrice}} / malam</text>
          </view>
        </view>

      </block>
    </view>

    <view a:if="{{ !isLoading && !successFetch }}" class="error-state">
      <error-reload onReload="fetchHotels" />
    </view>
  </scroll-view>

  <loading loading="{{ isLoading }}" />
</view>