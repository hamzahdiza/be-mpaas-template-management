.container-index.hotel-eco {
  background-color: #fafdfb;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.eco-hero {
  position: relative;
  height: 55vh;
  border-bottom-left-radius: 64px;
  border-bottom-right-radius: 64px;
  overflow: hidden;
  box-shadow: 0 25px 50px -12px rgba(0, 64, 32, 0.1);
}

.eco-hero-img {
  width: 100%;
  height: 100%;
}

.eco-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, #fafdfb, transparent, rgba(0,0,0,0.2));
}

.eco-hero-header {
  position: absolute;
  top: 64px;
  left: 32px;
  right: 32px;
  display: flex;
  justify-content: flex-start;
  z-index: 10;
}

.eco-badge-float {
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  padding: 10px 20px;
  border-radius: 32px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.eco-pulse {
  width: 8px;
  height: 8px;
  background-color: #10b981;
  border-radius: 50%;
  animation: ecoPulse 2s infinite;
}

@keyframes ecoPulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.5); opacity: 0.5; }
  100% { transform: scale(1); opacity: 1; }
}

.eco-badge-text {
  font-size: 10px;
  font-weight: 900;
  color: #064e3b;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.eco-hero-bottom {
  position: absolute;
  bottom: 64px;
  left: 40px;
  right: 40px;
  z-index: 10;
}

.eco-hotel-name {
  font-size: 40px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  line-height: 0.85;
  margin-bottom: 16px;
  display: block;
}

.eco-location-tag {
  font-size: 14px;
  font-weight: 900;
  color: #065f46;
  text-transform: uppercase;
  letter-spacing: -0.025em;
  font-style: italic;
}

.eco-content {
  padding: 64px 32px 96px;
}

.eco-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
}

.eco-section-title {
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  font-style: italic;
}

.eco-pagination {
  display: flex;
  gap: 8px;
}

.eco-page-dot {
  width: 8px;
  height: 4px;
  background-color: #ecfdf5;
  border-radius: 999px;
}

.eco-page-dot.active {
  width: 32px;
  background-color: #059669;
}

.eco-rooms-scroll {
  display: flex;
  white-space: nowrap;
  padding: 8px 0;
}

.eco-room-card {
  display: inline-block;
  width: 300px;
  background-color: white;
  padding: 20px;
  border-radius: 64px;
  margin-right: 32px;
  box-shadow: 0 32px 64px -12px rgba(0, 64, 32, 0.1);
  border: 1px solid #ecfdf5;
}

.eco-card-img-container {
  position: relative;
  width: 100%;
  aspect-ratio: 4/3;
  border-radius: 56px;
  overflow: hidden;
  margin-bottom: 32px;
}

.eco-card-img {
  width: 100%;
  height: 100%;
}

.eco-price-tag {
  position: absolute;
  top: 24px;
  left: 24px;
  background-color: #059669;
  padding: 8px 16px;
  border-radius: 999px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.eco-price-text {
  font-size: 10px;
  font-weight: 900;
  color: white;
  letter-spacing: -0.025em;
}

.eco-card-info {
  padding: 0 16px 16px;
}

.eco-room-name {
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  font-style: italic;
  margin-bottom: 8px;
  display: block;
}

.eco-room-meta {
  font-size: 12px;
  font-weight: 700;
  color: rgba(5, 150, 105, 0.6);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
