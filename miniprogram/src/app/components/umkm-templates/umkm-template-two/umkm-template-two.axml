<view class="umkm-v2-container">
  <view class="shop-header">
    <view class="shop-info">
      <image src="{{data.bannerUrl}}" class="shop-logo" mode="aspectFill" />
      <view>
        <text class="shop-name">{{data.name}}</text>
        <view class="shop-meta">
          <text class="rating">Γÿà 4.9</text>
          <text class="spacer">ΓÇó</text>
          <text class="location">{{data.location}}</text>
        </view>
      </view>
    </view>
    <view class="search-box">
      <icon type="search" size="14" />
      <text>Search items...</text>
    </view>
  </view>

  <view class="featured-row">
    <view class="row-header">
      <text class="row-title">NEW ARRIVALS</text>
      <text class="see-all">See All</text>
    </view>
    <scroll-view scroll-x="{{true}}" class="h-scroll">
      <block a:for="{{data.products}}">
        <view class="h-card" onTap="onProductTap" data-item="{{item}}">
          <image src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="h-info">
            <text class="h-name">{{item.name}}</text>
            <text class="h-price">Rp {{item.price.toLocaleString('id-ID')}}</text>
            <view class="add-mini" catchTap="onAddToCart" data-item="{{item}}">+</view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <view class="main-grid">
    <text class="row-title">FOR YOU</text>
    <view class="p-grid">
      <block a:for="{{data.products}}">
        <view class="p-card" onTap="onProductTap" data-item="{{item}}">
          <image src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="p-info">
            <text class="p-name">{{item.name}}</text>
            <view class="p-bottom">
              <text class="p-price">Rp {{item.price.toLocaleString('id-ID')}}</text>
              <view class="add-pill" catchTap="onAddToCart" data-item="{{item}}">Add</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="cart-bar {{cartCount > 0 ? 'active' : ''}}" onTap="onCheckoutClick" a:if="{{cartCount > 0}}">
    <view class="cart-left">
      <view class="cart-badge">{{cartCount}}</view>
      <text class="cart-total">Rp {{totalCartPrice.toLocaleString('id-ID')}}</text>
    </view>
    <view class="checkout-btn">Checkout ΓåÆ</view>
  </view>
</view>
