.rental-v4-container {
  padding: 24px;
  background: white;
  min-height: 100vh;
}

.v4-header {
  margin-bottom: 32px;
}

.v4-title {
  font-size: 32px;
  font-weight: 900;
  color: #000;
  display: block;
}

.v4-subtitle {
  font-size: 14px;
  color: #999;
  font-weight: 500;
}

.v4-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.v4-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px;
  background: #F9FAFB;
  border-radius: 24px;
  border: 1px solid #F3F4F6;
}

.v4-card-left {
  flex: 1;
}

.v4-vname {
  font-size: 18px;
  font-weight: 800;
  color: #111;
  display: block;
}

.v4-vtype {
  font-size: 12px;
  color: #6B7280;
  margin-top: 4px;
  display: block;
}

.v4-price-row {
  margin-top: 16px;
}

.v4-vprice {
  font-size: 15px;
  font-weight: 800;
  color: #000;
}

.v4-vunit {
  font-size: 10px;
  color: #999;
  margin-left: 4px;
}

.v4-vimg {
  width: 120px;
  height: 80px;
  border-radius: 12px;
}
