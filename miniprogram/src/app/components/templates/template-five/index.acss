.t5-container {
    background-color: #F9FAFB;
    min-height: 100vh;
    padding-bottom: 32px;
}

/* Sticky Header */
.t5-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(249, 250, 251, 0.95);
    backdrop-filter: blur(4px);
    border-bottom: 1px solid #E5E7EB;
}

.t5-status-bar {
    height: 44px; /* Standard status bar height */
}

.t5-nav-bar {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
}

.t5-back-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: -8px;
}

.t5-back-icon {
    width: 24px;
    height: 24px;
}

.t5-nav-title {
    font-size: 16px;
    font-weight: 600;
    color: #111827;
    flex: 1;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 8px;
}

.t5-nav-spacer {
    width: 40px;
    height: 40px;
}

.t5-banner-container {
    padding: 24px 20px 0;
}

.t5-swiper {
    height: 220px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.t5-banner-image {
    width: 100%;
    height: 100%;
}

.t5-content {
    padding: 24px 20px;
}

.t5-title {
    font-size: 26px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
    margin-bottom: 12px;
    display: block;
}

.t5-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
}

.t5-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 6px 12px;
}

.t5-pill-text {
    font-size: 13px;
    font-weight: 500;
    color: #4B5563;
}

.t5-icon {
    width: 16px;
    height: 16px;
}

.t5-icon-text {
    font-size: 14px;
}

.t5-socials {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
}

.t5-social-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 6px 12px;
}

.t5-social-text {
    font-size: 12px;
    font-weight: 500;
    color: #4B5563;
}

.t5-icon-sm {
    width: 12px;
    height: 12px;
}

.t5-description-box {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 32px;
}

.t5-description-text {
    font-size: 15px;
    line-height: 1.6;
    color: #4B5563;
    display: block;
}

.line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.t5-read-more {
    margin-top: 12px;
    font-size: 12px;
    font-weight: 700;
    color: #111827;
    text-transform: uppercase;
}

.t5-tickets-section {
    margin-top: 0;
}

.t5-section-title {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 16px;
}

.t5-tickets-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.t5-ticket-card {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 20px;
    position: relative;
    overflow: hidden;
}

.t5-ticket-header {
    margin-bottom: 8px;
}

.t5-ticket-name {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
}

.t5-ticket-desc {
    font-size: 13px;
    color: #6B7280;
    margin-bottom: 16px;
    display: block;
    line-height: 1.4;
}

.t5-ticket-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid #F3F4F6;
    padding-top: 16px;
}

.t5-price-label {
    font-size: 10px;
    text-transform: uppercase;
    color: #9CA3AF;
    font-weight: 600;
    display: block;
    margin-bottom: 2px;
}

.t5-price-wrapper {
    display: flex;
    flex-direction: column;
}

.t5-price-normal {
    font-size: 11px;
    color: #9CA3AF;
    text-decoration: line-through;
    margin-bottom: 2px;
}

.t5-price-value {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
}

.t5-arrow-btn {
    width: 32px;
    height: 32px;
    background: #111827;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.t5-icon-white {
    width: 16px;
    height: 16px;
    filter: brightness(0) invert(1);
}
