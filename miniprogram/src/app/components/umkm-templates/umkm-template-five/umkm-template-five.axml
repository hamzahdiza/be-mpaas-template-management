<view class="umkm-v5-container">
  <view class="v5-header">
    <image src="{{data.bannerUrl}}" mode="aspectFill" class="v5-banner" />
    <view class="v5-shop-info">
      <text class="v5-name">{{data.name}}</text>
      <text class="v5-loc">📍 {{data.location}}</text>
    </view>
  </view>
  <view class="v5-list">
    <block a:for="{{data.products}}">
      <view class="v5-item" onTap="onProductTap" data-item="{{item}}">
        <image src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="v5-details">
          <text class="v5-pname">{{item.name}}</text>
          <text class="v5-pprice">Rp {{item.price.toLocaleString('id-ID')}}</text>
        </view>
        <view class="v5-add" catchTap="onAddToCart" data-item="{{item}}">+</view>
      </view>
    </block>
  </view>
  <view class="v5-cart {{cartCount > 0 ? 'active' : ''}}" onTap="onCheckoutClick">
    <view class="v5-cart-badge">{{cartCount}}</view>
    <text>Rp {{totalCartPrice.toLocaleString('id-ID')}}</text>
    <text>GO ΓåÆ</text>
  </view>
</view>
