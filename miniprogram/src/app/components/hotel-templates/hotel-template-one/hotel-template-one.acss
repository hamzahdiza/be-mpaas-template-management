.container-index.hotel-modern {
  background-color: white;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.hero-hotel {
  position: relative;
  height: 60vh;
  overflow: hidden;
}

.hotel-swiper {
  width: 100%;
  height: 100%;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.hero-overlay-hotel {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0.2), transparent);
}

.hero-header-hotel {
  position: absolute;
  top: 48px;
  left: 32px;
  right: 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.menu-btn-hotel {
  background-color: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 8px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  display: flex;
  gap: 4px;
}

.menu-dot {
  width: 4px;
  height: 4px;
  background-color: white;
  border-radius: 50%;
}

.book-now-pill {
  background-color: #2563eb;
  padding: 8px 16px;
  border-radius: 999px;
  box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
}

.book-now-text {
  font-size: 10px;
  font-weight: 900;
  color: white;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.hero-bottom-hotel {
  position: absolute;
  bottom: 48px;
  left: 32px;
  right: 32px;
  z-index: 10;
}

.stars-hotel {
  display: flex;
  gap: 4px;
  margin-bottom: 16px;
}

.star-icon {
  font-size: 18px;
  color: #475569;
}

.star-icon.active {
  color: #fbbf24;
}

.hotel-name-modern {
  font-size: 40px;
  font-weight: 900;
  letter-spacing: -0.05em;
  color: white;
  text-transform: uppercase;
  font-style: italic;
  line-height: 0.85;
  margin-bottom: 16px;
  display: block;
}

.location-row-hotel {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pin-icon {
  width: 16px;
  height: 16px;
}

.location-text-hotel {
  font-size: 14px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 0.025em;
}

.content-hotel {
  padding: 48px 32px 96px;
}

.desc-section-hotel {
  padding-bottom: 32px;
  border-bottom: 1px solid #f1f5f9;
  margin-bottom: 48px;
}

.section-tag-hotel {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  margin-bottom: 8px;
  display: block;
}

.hotel-desc-text {
  font-size: 16px;
  line-height: 1.6;
  color: #475569;
  font-weight: 500;
  font-style: italic;
}

.rooms-section-hotel {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.section-header-hotel {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title-hotel {
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  text-transform: uppercase;
  font-style: italic;
}

.view-all-hotel {
  font-size: 12px;
  font-weight: 700;
  color: #2563eb;
  border-bottom: 1px solid rgba(37, 99, 235, 0.3);
  padding-bottom: 2px;
}

.rooms-list-hotel {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.room-card-modern {
  display: flex;
  flex-direction: column;
}

.room-img-container-modern {
  position: relative;
  aspect-ratio: 16/10;
  border-radius: 40px;
  overflow: hidden;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
  margin-bottom: 24px;
}

.room-img-modern {
  width: 100%;
  height: 100%;
}

.room-price-badge-modern {
  position: absolute;
  top: 24px;
  right: 24px;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 10px 20px;
  border-radius: 16px;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
}

.room-price-text {
  font-size: 12px;
  font-weight: 900;
  color: #2563eb;
  letter-spacing: -0.05em;
}

.room-info-modern {
  padding: 0 8px;
}

.room-name-modern {
  font-size: 20px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.025em;
  text-transform: uppercase;
  margin-bottom: 8px;
  display: block;
}

.room-meta-modern {
  display: flex;
  align-items: center;
  gap: 16px;
}

.meta-item {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.meta-dot {
  width: 4px;
  height: 4px;
  background-color: #cbd5e1;
  border-radius: 50%;
}
