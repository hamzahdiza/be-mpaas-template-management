.container-detail-urban {
  background-color: white;
  min-height: 100vh;
  padding-bottom: 96px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.urban-detail-body {
  padding: 40px;
}

.urban-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 64px;
}

.urban-back-btn-large {
  color: #0f172a;
  transition: all 0.2s;
}

.urban-tech-label {
  font-size: 10px;
  font-weight: 900;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.4em;
}

.urban-accent-dot {
  width: 4px;
  height: 16px;
  background-color: #f1f5f9;
  border-radius: 999px;
}

.urban-hero-room-large {
  position: relative;
  aspect-ratio: 4/5;
  background-color: #0f172a;
  margin-bottom: 64px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.urban-room-img-large {
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

.urban-hero-badge {
  position: absolute;
  bottom: 40px;
  left: 40px;
  background-color: white;
  padding: 32px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}

.urban-hero-type {
  font-size: 40px;
  font-weight: 900;
  color: #0f172a;
  letter-spacing: -0.05em;
  font-style: italic;
  text-transform: uppercase;
  line-height: 1;
}

.urban-info-section-large {
  display: flex;
  flex-direction: column;
  gap: 48px;
}

.urban-info-header-large {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 40px;
  border-bottom: 8px solid #2563eb;
}

.urban-room-name-large {
  font-size: 40px;
  font-weight: 900;
  letter-spacing: -0.05em;
  color: #0f172a;
  text-transform: uppercase;
  font-style: italic;
  line-height: 1;
  flex: 1;
}

.urban-price-col-large {
  text-align: right;
}

.urban-price-val-large {
  font-size: 24px;
  font-weight: 900;
  color: #0f172a;
  font-style: italic;
  letter-spacing: -0.05em;
  display: block;
}

.urban-price-label-large {
  font-size: 10px;
  font-weight: 900;
  color: #cbd5e1;
  text-transform: uppercase;
}

.urban-room-desc-large {
  font-size: 18px;
  font-weight: 700;
  color: #64748b;
  line-height: 1.6;
  font-style: italic;
  padding-right: 40px;
}

.urban-footer-large {
  width: 100%;
  padding: 32px;
  background-color: #0f172a;
  color: white;
  text-align: center;
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.5em;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.2);
}
