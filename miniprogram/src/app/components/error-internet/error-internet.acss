.intf .ant-popup-transform-bottom {
  display: flex;
  bottom: 48px;
  right: 24px;
  left: 24px;
  padding: 24px 16px;
  border-radius: 16px;
  background: var(--functional-bw-tones-white, #FFF);
  box-shadow: 0 10px 32px 0 rgba(78, 78, 78, 0.27);
}

.img-style {
  width: 100%;
  height: 150px;
}

.intf .ant-popup-content {
  display: grid;
  flex-direction: column;
}

.default-btn {
  max-width: 100%;
  max-height: 48px;
  border: 1px solid #7a7a7a;
  font-size: 14px;
  font-weight: 600;
}

.primary-btn {
  max-width: 100%;
  max-height: 48px;
  border: none;
  font-size: 14px;
  font-weight: 600;
  line-height: 48px;
}

