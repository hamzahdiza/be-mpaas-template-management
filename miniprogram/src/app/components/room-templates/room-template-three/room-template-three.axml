<view class="container-detail-eco">
  <view class="eco-detail-header">
    <view class="eco-back-btn" onTap="onBack">
      <icon type="left" size="24" color="#059669" />
    </view>
    <text class="eco-essence-label">Sanctuary Detail</text>
    <view class="eco-icon-btn">
      <text class="eco-icon-leaf">🌿</text>
    </view>
  </view>

  <view class="eco-detail-body">
    <view class="eco-item-img-container">
      <view class="eco-img-accent" />
      <image class="eco-item-img" src="{{room.images[0]}}" mode="aspectFill" />
    </view>

    <view class="eco-info-section">
      <text class="eco-item-name-detail">{{room.name}}</text>
      
      <view class="eco-price-rating-row">
        <view class="eco-price-badge">
          <text class="eco-price-val">Rp {{room.pricePerNight.toLocaleString('id-ID')}}</text>
        </view>
        <view class="eco-avatars">
          <view class="eco-avatar" style="background-color: #ecfdf5" />
          <view class="eco-avatar" style="background-color: #d1fae5" />
          <view class="eco-avatar" style="background-color: #a7f3d0" />
          <view class="eco-avatar-more">+12</view>
        </view>
      </view>

      <view class="eco-desc-container">
        <view class="eco-desc-line" />
        <text class="eco-item-desc">{{room.description}}</text>
      </view>

      <view class="eco-footer-action">
        <view class="eco-request-btn" onTap="onBook">
          Request Sanctuary →
        </view>
      </view>
    </view>
  </view>
</view>
